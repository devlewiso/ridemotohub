---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<!-- Brand -->
		<div class="footer-brand">
			<div class="brand-logo">
				<div class="logo-icon-wrap">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none">
						<circle cx="5.5" cy="15.5" r="3" fill="white"/>
						<circle cx="18.5" cy="15.5" r="3" fill="white"/>
						<path d="M8.5 15.5H15.5M12 6L15.5 15.5M12 6L8 10H14L15.5 15.5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				</div>
				<span class="logo-text">RideMotoHub</span>
			</div>
			<p class="brand-tagline">La comunidad que une a todos los riders de Guatemala</p>
		</div>

		<!-- Links -->
		<div class="footer-links">
			<div class="link-group">
				<h4>Navegación</h4>
				<a href="/">Inicio</a>
				<a href="/blog">Blog</a>
				<a href="/about">Nosotros</a>
			</div>
			<div class="link-group">
				<h4>Comunidad</h4>
				<a href="/rutas">Rutas</a>
				<a href="/eventos">Eventos</a>
				<a href="/tips">Tips & Consejos</a>
			</div>
			<div class="link-group">
				<h4>Legal</h4>
				<a href="/privacidad">Privacidad</a>
				<a href="/terminos">Términos de Uso</a>
			</div>
		</div>
	</div>

	<div class="footer-bottom">
		<span>&copy; {today.getFullYear()} RideMotoHub Guatemala</span>
		<span class="dot">·</span>
		<span>Hecho con ❤️ para la comunidad motera</span>
	</div>
</footer>

<style>
	footer {
		background: var(--ov-surface-low, #121220);
		color: var(--ov-on-surface, #e9e6f9);
		font-family: 'Manrope', sans-serif;
	}

	.footer-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 2rem 3rem;
		display: grid;
		grid-template-columns: 1.4fr 2fr;
		gap: 4rem;
		border-bottom: 1px solid rgba(71, 70, 85, 0.25);
	}

	/* ── Brand ── */
	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.brand-logo {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.logo-icon-wrap {
		width: 36px;
		height: 36px;
		border-radius: 10px;
		background: linear-gradient(135deg, #69daff, #ac89ff);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.logo-text {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 1.15rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		background: linear-gradient(135deg, #69daff, #ac89ff);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.brand-tagline {
		font-size: 0.875rem;
		color: var(--ov-on-surface-var, #aba9ba);
		margin: 0;
		line-height: 1.6;
		max-width: 280px;
	}

	/* ── Links grid ── */
	.footer-links {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}

	.link-group h4 {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ov-primary, #69daff);
		margin: 0 0 1.1rem;
	}

	.link-group a {
		display: block;
		font-size: 0.875rem;
		color: var(--ov-on-surface-var, #aba9ba);
		text-decoration: none;
		margin-bottom: 0.65rem;
		transition: color 0.2s, transform 0.2s;
	}

	.link-group a:hover {
		color: var(--ov-on-surface, #e9e6f9);
		transform: translateX(4px);
	}

	/* ── Bottom bar ── */
	.footer-bottom {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1.5rem 2rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.8rem;
		color: var(--ov-on-surface-var, #aba9ba);
		opacity: 0.7;
	}

	.dot { opacity: 0.4; }

	/* ── Responsive ── */
	@media (max-width: 768px) {
		.footer-inner {
			grid-template-columns: 1fr;
			gap: 2.5rem;
			padding: 3rem 1.5rem 2.5rem;
		}

		.footer-links {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.5rem;
		}

		.brand-tagline { max-width: 100%; }

		.footer-bottom {
			padding: 1.25rem 1.5rem;
			flex-wrap: wrap;
			gap: 0.4rem;
		}
	}

	@media (max-width: 480px) {
		.footer-links { grid-template-columns: 1fr 1fr; }
	}
</style>
