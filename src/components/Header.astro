---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header id="main-header">
	<nav>
		<div class="logo">
			<a href="/">
				<div class="logo-icon-wrap">
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none">
						<circle cx="5.5" cy="15.5" r="3" fill="white"/>
						<circle cx="18.5" cy="15.5" r="3" fill="white"/>
						<path d="M5.5 15.5h3.5l2-5h4.5l2.5 4h1" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
						<path d="M14 10.5l-1-3.5h-2.5" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
					</svg>
				</div>
				<span class="logo-text">{SITE_TITLE}</span>
			</a>
		</div>

		<div class="nav-links" id="nav-links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/rutas">Rutas</HeaderLink>
			<HeaderLink href="/eventos">Eventos</HeaderLink>
			<HeaderLink href="/tips">Tips</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">Nosotros</HeaderLink>
		</div>

		<div class="nav-right">
			<div class="social-links">
				<a href="https://www.instagram.com/ridemotohub" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-btn instagram">
					<svg viewBox="0 0 24 24" width="17" height="17" fill="none">
						<path fill="currentColor" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
					</svg>
				</a>
				<a href="https://www.facebook.com/ridemotohub" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-btn facebook">
					<svg viewBox="0 0 24 24" width="17" height="17" fill="none">
						<path fill="currentColor" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
					</svg>
				</a>
				<a href="https://chat.whatsapp.com/ridemotohub" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="social-btn whatsapp">
					<svg viewBox="0 0 24 24" width="17" height="17" fill="none">
						<path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
					</svg>
				</a>
			</div>

			<a href="/blog" class="cta-btn">Unirme</a>

			<button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false">
				<span></span><span></span><span></span>
			</button>
		</div>
	</nav>
</header>

<style>
	/* Obsidian Velocity tokens */
	:root {
		--ov-primary:        #69daff;
		--ov-primary-dim:    #00c0ea;
		--ov-secondary:      #ac89ff;
		--ov-tertiary:       #ff5dd7;
		--ov-bg:             #0d0d19;
		--ov-surface:        #0d0d19;
		--ov-surface-low:    #121220;
		--ov-surface-mid:    #181827;
		--ov-surface-high:   #1e1e2f;
		--ov-surface-top:    #242436;
		--ov-surface-bright: #2a2a3e;
		--ov-on-surface:     #e9e6f9;
		--ov-on-surface-var: #aba9ba;
		--ov-outline:        #757484;
		--ov-outline-var:    #474655;
		--ov-tint:           #69daff;
	}

	@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700&display=swap');

	header {
		position: sticky;
		top: 0;
		z-index: 1000;
		height: 64px;
		/* Glass formula: surface_variant at 60% + blur 20px */
		background: rgba(36, 36, 54, 0.6);
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		border-bottom: 1px solid rgba(105, 218, 255, 0.06);
		/* Ambient shadow tinted with surface_tint */
		box-shadow: 0 8px 40px rgba(105, 218, 255, 0.06);
		transition: background 0.3s ease, box-shadow 0.3s ease;
	}

	header.scrolled {
		background: rgba(13, 13, 25, 0.94);
		box-shadow: 0 4px 40px rgba(105, 218, 255, 0.08);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 2rem;
		height: 100%;
		gap: 2rem;
	}

	/* ── Logo ── */
	.logo a {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		flex-shrink: 0;
		transition: opacity 0.2s ease;
	}
	.logo a:hover { opacity: 0.85; }

	.logo-icon-wrap {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		/* CTA gradient: primary → secondary at 135° */
		background: linear-gradient(135deg, var(--ov-primary), var(--ov-secondary));
		border-radius: 10px;
		/* Ambient glow tinted with surface_tint */
		box-shadow: 0 0 16px rgba(105, 218, 255, 0.35);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		flex-shrink: 0;
	}
	.logo a:hover .logo-icon-wrap {
		transform: scale(1.1) rotate(-6deg);
		box-shadow: 0 0 28px rgba(105, 218, 255, 0.55);
	}

	.logo-text {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 1.2rem;
		font-weight: 800;
		font-style: italic;
		/* tight letter-spacing per Obsidian Velocity headline rule */
		letter-spacing: -0.04em;
		color: var(--ov-on-surface);
	}

	/* ── Nav Links ── */
	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.1rem;
		flex: 1;
		justify-content: center;
	}

	.nav-links :global(a) {
		font-family: 'Manrope', sans-serif;
		font-size: 0.875rem;
		font-weight: 500;
		/* on_surface_variant for nav links */
		color: var(--ov-on-surface-var);
		text-decoration: none;
		padding: 0.4rem 0.85rem;
		border-radius: 8px;
		position: relative;
		transition: color 0.2s ease, background 0.2s ease;
		white-space: nowrap;
	}
	.nav-links :global(a:hover) {
		color: var(--ov-on-surface);
		background: rgba(105, 218, 255, 0.06);
	}
	.nav-links :global(a.active) {
		color: var(--ov-on-surface);
		font-weight: 600;
		text-decoration: none;
	}
	/* Active indicator — cyan primary */
	.nav-links :global(a.active::after) {
		content: '';
		position: absolute;
		bottom: 0px;
		left: 0.85rem;
		right: 0.85rem;
		height: 2px;
		background: var(--ov-primary);
		border-radius: 2px;
		box-shadow: 0 0 6px rgba(105, 218, 255, 0.6);
	}

	/* ── Right ── */
	.nav-right {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-shrink: 0;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.1rem;
	}

	.social-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 8px;
		color: rgba(171, 169, 186, 0.6);
		text-decoration: none;
		transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
	}
	.social-btn:hover { transform: translateY(-2px); }
	.social-btn.instagram:hover { color: #e1306c; background: rgba(225,48,108,0.1); }
	.social-btn.facebook:hover  { color: #1877f2; background: rgba(24,119,242,0.1); }
	.social-btn.whatsapp:hover  { color: #25d366; background: rgba(37,211,102,0.1); }

	/* ── CTA — gradient primary → secondary, pill shape ── */
	.cta-btn {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.01em;
		padding: 0.45rem 1.25rem;
		background: linear-gradient(135deg, var(--ov-primary), var(--ov-secondary));
		color: #004a5d;
		border-radius: 9999px;
		text-decoration: none;
		box-shadow: 0 4px 14px rgba(105, 218, 255, 0.25);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
		white-space: nowrap;
	}
	.cta-btn:hover {
		transform: scale(1.05);
		/* On hover: outer glow with primary_dim */
		box-shadow: 0 0 0 3px rgba(0, 192, 234, 0.25), 0 6px 20px rgba(105, 218, 255, 0.35);
	}
	.cta-btn:active { transform: scale(0.97); }

	/* ── Hamburger ── */
	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 36px;
		height: 36px;
		padding: 0.4rem;
		/* Ghost border fallback: outline_variant at 20% */
		background: rgba(36, 36, 54, 0.5);
		border: 1px solid rgba(71, 70, 85, 0.4);
		border-radius: 8px;
		cursor: pointer;
		transition: background 0.2s ease;
	}
	.hamburger:hover { background: rgba(105, 218, 255, 0.08); }
	.hamburger span {
		display: block;
		height: 2px;
		background: var(--ov-on-surface-var);
		border-radius: 2px;
		transition: transform 0.3s ease, opacity 0.3s ease;
	}
	.hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
	.hamburger.open span:nth-child(2) { opacity: 0; }
	.hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

	/* ── Responsive ── */
	@media (max-width: 960px) { .social-links { display: none; } }

	@media (max-width: 768px) {
		nav { padding: 0 1.25rem; gap: 0.75rem; }
		.hamburger { display: flex; }
		.cta-btn { display: none; }

		.nav-links {
			display: none;
			position: absolute;
			top: 64px;
			left: 0; right: 0;
			flex-direction: column;
			align-items: stretch;
			background: rgba(13, 13, 25, 0.97);
			backdrop-filter: blur(20px);
			border-bottom: 1px solid rgba(71, 70, 85, 0.2);
			padding: 0.75rem 1.25rem 1.5rem;
			animation: slideDown 0.22s ease;
		}
		.nav-links.open { display: flex; }
		.nav-links :global(a) { padding: 0.75rem 1rem; font-size: 0.95rem; border-radius: 8px; }
		.nav-links :global(a:hover) { background: rgba(105, 218, 255, 0.06); }
		.nav-links :global(a.active::after) { display: none; }
	}

	@keyframes slideDown {
		from { opacity: 0; transform: translateY(-6px); }
		to   { opacity: 1; transform: translateY(0); }
	}
</style>

<script>
	const header    = document.getElementById('main-header');
	const hamburger = document.getElementById('hamburger');
	const navLinks  = document.getElementById('nav-links');

	window.addEventListener('scroll', () => {
		header?.classList.toggle('scrolled', window.scrollY > 20);
	}, { passive: true });

	hamburger?.addEventListener('click', () => {
		const isOpen = navLinks?.classList.toggle('open');
		hamburger.classList.toggle('open', !!isOpen);
		hamburger.setAttribute('aria-expanded', String(!!isOpen));
	});

	navLinks?.querySelectorAll('a').forEach(link => {
		link.addEventListener('click', () => {
			navLinks.classList.remove('open');
			hamburger?.classList.remove('open');
			hamburger?.setAttribute('aria-expanded', 'false');
		});
	});
</script>
