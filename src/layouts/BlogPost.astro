---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="es">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700&display=swap');

			:root {
				--ov-primary:        #69daff;
				--ov-secondary:      #ac89ff;
				--ov-bg:             #0d0d19;
				--ov-surface-low:    #121220;
				--ov-surface-mid:    #181827;
				--ov-on-surface:     #e9e6f9;
				--ov-on-surface-var: #aba9ba;
				--ov-outline-var:    #474655;
			}

			body {
				background: var(--ov-bg);
				color: var(--ov-on-surface);
				font-family: 'Manrope', sans-serif;
				margin: 0;
				padding: 0;
			}

			/* Override global.css constraints */
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}

			/* Override global.css img border-radius inside hero */
			.hero-section img {
				border-radius: 0 !important;
				max-width: none;
				height: 100%;
			}

			/* ── Hero: full viewport como el inicio ── */
			.hero-section {
				position: relative;
				width: 100%;
				min-height: 88vh;
				display: flex;
				align-items: center;
				justify-content: center;
				overflow: hidden;
				background: var(--ov-bg);
			}

			.hero-section img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center;
				display: block;
				filter: brightness(0.38) saturate(1.1);
				z-index: 1;
			}

			/* Gradient fade bottom */
			.hero-section::after {
				content: '';
				position: absolute;
				bottom: 0;
				left: 0;
				right: 0;
				height: 45%;
				background: linear-gradient(to bottom, transparent, var(--ov-bg));
				pointer-events: none;
				z-index: 2;
			}

			/* ── Contenido sobre la imagen ── */
			.post-header {
				position: relative;
				z-index: 3;
				text-align: center;
				max-width: 820px;
				padding: 2rem 2rem;
				animation: fadeInUp 0.9s ease-out;
			}

			.post-meta {
				display: inline-flex;
				align-items: center;
				gap: 0.65rem;
				margin-bottom: 1.5rem;
				padding: 0.4rem 1.1rem;
				background: rgba(36, 36, 54, 0.6);
				border: 1px solid rgba(105, 218, 255, 0.2);
				backdrop-filter: blur(12px);
				border-radius: 9999px;
				font-family: 'Manrope', sans-serif;
				font-size: 0.8rem;
				font-weight: 600;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				color: var(--ov-primary);
			}

			.post-meta .dot {
				width: 3px;
				height: 3px;
				border-radius: 50%;
				background: var(--ov-outline-var);
			}

			.post-meta .date {
				color: var(--ov-on-surface-var);
				font-weight: 500;
				text-transform: none;
				letter-spacing: 0;
			}

			.post-header h1 {
				font-family: 'Space Grotesk', sans-serif;
				font-size: clamp(2.2rem, 5.5vw, 3.8rem);
				font-weight: 900;
				letter-spacing: -0.04em;
				line-height: 1.08;
				color: #fff;
				margin: 0;
				text-shadow: 0 2px 40px rgba(0,0,0,0.5);
			}

			/* ── Contenido del post ── */
			.prose {
				max-width: 820px;
				margin: 0 auto;
				padding: 0 2rem 6rem;
				color: var(--ov-on-surface-var);
				font-size: 1.05rem;
				line-height: 1.8;
			}

			.prose :global(h2) {
				font-family: 'Space Grotesk', sans-serif;
				font-size: 1.6rem;
				font-weight: 700;
				letter-spacing: -0.03em;
				color: var(--ov-on-surface);
				margin: 2.5rem 0 1rem;
			}

			.prose :global(h3) {
				font-family: 'Space Grotesk', sans-serif;
				font-size: 1.2rem;
				font-weight: 600;
				color: var(--ov-on-surface);
				margin: 2rem 0 0.75rem;
			}

			.prose :global(p) {
				margin: 0 0 1.4rem;
				color: var(--ov-on-surface-var);
			}

			.prose :global(strong) {
				color: var(--ov-on-surface);
				font-weight: 600;
			}

			.prose :global(a) {
				color: var(--ov-primary);
				text-decoration: none;
				border-bottom: 1px solid rgba(105, 218, 255, 0.3);
				transition: border-color 0.2s;
			}

			.prose :global(a:hover) {
				border-color: var(--ov-primary);
			}

			.prose :global(hr) {
				border: none;
				border-top: 1px solid rgba(71, 70, 85, 0.4);
				margin: 2.5rem 0;
			}

			.prose :global(ul), .prose :global(ol) {
				padding-left: 1.5rem;
				margin: 0 0 1.4rem;
			}

			.prose :global(li) {
				margin-bottom: 0.5rem;
			}

			.prose :global(blockquote) {
				margin: 2rem 0;
				padding: 1.25rem 1.5rem;
				background: var(--ov-surface-mid);
				border-left: 3px solid var(--ov-primary);
				border-radius: 0 8px 8px 0;
				color: var(--ov-on-surface);
				font-style: italic;
			}

			.prose :global(code) {
				background: var(--ov-surface-mid);
				color: var(--ov-primary);
				padding: 0.2em 0.45em;
				border-radius: 4px;
				font-size: 0.9em;
			}

			@keyframes fadeInUp {
				from { opacity: 0; transform: translateY(24px); }
				to   { opacity: 1; transform: translateY(0); }
			}

			@media (max-width: 768px) {
				.hero-section { min-height: 80vh; }
				.post-header { padding: 1.5rem; }
				.prose { padding: 0 1.25rem 4rem; }
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<!-- Hero full viewport con título encima -->
				<div class="hero-section">
					{heroImage && <Image width={1920} height={1080} src={heroImage} alt={title} />}
					<div class="post-header">
						<div class="post-meta">
							<span>RideMotoHub</span>
							<span class="dot"></span>
							<span class="date"><FormattedDate date={pubDate} /></span>
							{updatedDate && (
								<>
									<span class="dot"></span>
									<span class="date">Actualizado: <FormattedDate date={updatedDate} /></span>
								</>
							)}
						</div>
						<h1>{title}</h1>
					</div>
				</div>

				<!-- Contenido -->
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
