---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props extends CollectionEntry<'blog'>['data'] {
	slug?: string;
	relatedPosts?: CollectionEntry<'blog'>[];
	wordCount?: number;
}

const { title, description, pubDate, updatedDate, heroImage, slug, imageAlt, category, author, relatedPosts = [], wordCount = 0 } = Astro.props;

// Generate SEO-optimized alt text
const optimizedAlt = imageAlt || `${category ? category + ' - ' : ''}${title} - RideMotoHub Guatemala`;

// Calculate reading time (200 words per minute)
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Check if content is updated
const isUpdated = updatedDate && updatedDate.valueOf() !== pubDate.valueOf();

// Schema.org BreadcrumbList
const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Inicio",
			item: new URL("/", Astro.site),
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "Blog",
			item: new URL("/blog/", Astro.site),
		},
		{
			"@type": "ListItem",
			position: 3,
			name: title,
			item: new URL(`/blog/${slug}/`, Astro.site),
		},
	],
};

// Schema.org BlogPosting structured data
const blogSchema = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: title,
	description: description,
	image: heroImage ? new URL(heroImage.src, Astro.site) : null,
	datePublished: pubDate.toISOString(),
	dateModified: updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
	author: author ? {
		"@type": "Person",
		name: author.name,
		url: Astro.site,
	} : {
		"@type": "Organization",
		name: "RideMotoHub Guatemala",
		url: Astro.site,
	},
	publisher: {
		"@type": "Organization",
		name: "RideMotoHub Guatemala",
		logo: {
			"@type": "ImageObject",
			url: new URL("/favicon.svg", Astro.site),
		},
	},
	mainEntityOfPage: {
		"@type": "WebPage",
		"@id": new URL(`/blog/${slug}/`, Astro.site),
	},
};

// Default author fallback
const postAuthor = author || { name: "RideMotoHub Team", since: 2020 };
---

<html lang="es">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		<style>
			@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700&display=swap');

			:root {
				--ov-primary:        #69daff;
				--ov-secondary:      #ac89ff;
				--ov-bg:             #0d0d19;
				--ov-surface-low:    #121220;
				--ov-surface-mid:    #181827;
				--ov-surface-high:   #1e1e2f;
				--ov-on-surface:     #e9e6f9;
				--ov-on-surface-var: #aba9ba;
				--ov-outline-var:    #474655;
			}

			body {
				background: var(--ov-bg);
				color: var(--ov-on-surface);
				font-family: 'Manrope', sans-serif;
				margin: 0;
				padding: 0;
			}

			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}

			/* Breadcrumb */
			.breadcrumb {
				background: var(--ov-surface-low);
				border-bottom: 1px solid rgba(71, 70, 85, 0.3);
				padding: 0.75rem 2rem;
			}

			.breadcrumb-inner {
				max-width: 1200px;
				margin: 0 auto;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
				font-size: 0.8rem;
				color: var(--ov-on-surface-var);
			}

			.breadcrumb-inner a {
				color: var(--ov-on-surface-var);
				text-decoration: none;
				transition: color 0.2s;
			}
			.breadcrumb-inner a:hover { color: var(--ov-primary); }

			.breadcrumb-sep { opacity: 0.4; }

			.breadcrumb-cat {
				color: var(--ov-primary);
				font-weight: 600;
			}

			.breadcrumb-current {
				color: var(--ov-on-surface);
				font-weight: 500;
				overflow: hidden;
				white-space: nowrap;
				text-overflow: ellipsis;
				max-width: 320px;
			}

			@media (max-width: 768px) {
				.breadcrumb { padding: 0.65rem 1.25rem; }
				.breadcrumb-current { max-width: 180px; }
			}

			/* Hero Section */
			.hero-section {
				position: relative;
				width: 100%;
				min-height: 88vh;
				display: flex;
				align-items: center;
				justify-content: center;
				overflow: hidden;
				background: var(--ov-bg);
			}

			.hero-section img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center;
				display: block;
				filter: brightness(0.38) saturate(1.1);
				z-index: 1;
			}

			.hero-section::after {
				content: '';
				position: absolute;
				bottom: 0;
				left: 0;
				right: 0;
				height: 45%;
				background: linear-gradient(to bottom, transparent, var(--ov-bg));
				pointer-events: none;
				z-index: 2;
			}

			/* Post Header */
			.post-header {
				position: relative;
				z-index: 3;
				text-align: center;
				max-width: 860px;
				padding: 2rem;
				animation: fadeInUp 0.9s ease-out;
			}

			.post-meta {
				display: inline-flex;
				align-items: center;
				gap: 0.65rem;
				margin-bottom: 1.25rem;
				padding: 0.4rem 1.1rem;
				background: rgba(36, 36, 54, 0.6);
				border: 1px solid rgba(105, 218, 255, 0.2);
				backdrop-filter: blur(12px);
				border-radius: 9999px;
				font-family: 'Manrope', sans-serif;
				font-size: 0.8rem;
				font-weight: 600;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				color: var(--ov-primary);
			}

			.post-meta .dot {
				width: 3px;
				height: 3px;
				border-radius: 50%;
				background: var(--ov-outline-var);
			}

			.post-meta .date {
				color: var(--ov-on-surface-var);
				font-weight: 500;
				text-transform: none;
				letter-spacing: 0;
			}

			/* Author Badge */
			.author-badge {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 1rem;
				padding: 0.5rem 1rem;
				background: rgba(172, 137, 255, 0.1);
				border: 1px solid rgba(172, 137, 255, 0.25);
				border-radius: 9999px;
				font-size: 0.85rem;
				color: var(--ov-secondary);
			}

			.author-badge .author-name {
				font-weight: 600;
			}

			.author-badge .author-since {
				font-size: 0.75rem;
				opacity: 0.8;
			}

			/* Reading Time */
			.reading-time {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				font-size: 0.85rem;
				color: var(--ov-on-surface-var);
				margin-bottom: 1rem;
			}

			.post-header h1 {
				font-family: 'Space Grotesk', sans-serif;
				font-size: clamp(2.2rem, 5.5vw, 3.8rem);
				font-weight: 900;
				letter-spacing: -0.04em;
				line-height: 1.08;
				color: #fff;
				margin: 0;
				text-shadow: 0 2px 40px rgba(0,0,0,0.5);
			}

			/* Updated Badge */
			.updated-badge {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				margin-top: 1rem;
				padding: 0.35rem 0.85rem;
				background: rgba(105, 218, 255, 0.1);
				border: 1px solid rgba(105, 218, 255, 0.3);
				border-radius: 9999px;
				font-size: 0.8rem;
				color: var(--ov-primary);
			}

			/* Layout with TOC */
			.content-layout {
				max-width: 1200px;
				margin: 0 auto;
				display: grid;
				grid-template-columns: 280px 1fr;
				gap: 3rem;
				padding: 0 2rem 6rem;
			}

			@media (max-width: 1024px) {
				.content-layout {
					grid-template-columns: 1fr;
					padding: 0 1.25rem 4rem;
				}
			}

			/* TOC Sidebar */
			.toc-sidebar {
				position: sticky;
				top: 100px;
				height: fit-content;
			}

			.toc-container {
				background: var(--ov-surface-mid);
				border: 1px solid rgba(105, 218, 255, 0.1);
				border-radius: 12px;
				padding: 1.25rem;
			}

			.toc-title {
				font-family: 'Space Grotesk', sans-serif;
				font-size: 0.85rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--ov-on-surface-var);
				margin-bottom: 1rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.toc-list {
				list-style: none;
				margin: 0;
				padding: 0;
				font-size: 0.9rem;
			}

			.toc-list li {
				margin: 0;
			}

			.toc-list a {
				display: block;
				padding: 0.5rem 0;
				color: var(--ov-on-surface-var);
				text-decoration: none;
				border-bottom: none;
				border-left: 2px solid transparent;
				padding-left: 0.75rem;
				margin-left: -0.75rem;
				transition: all 0.2s;
			}

			.toc-list a:hover,
			.toc-list a.active {
				color: var(--ov-primary);
				border-left-color: var(--ov-primary);
				background: rgba(105, 218, 255, 0.05);
			}

			.toc-list .toc-h2 {
				font-weight: 500;
			}

			.toc-list .toc-h3 {
				padding-left: 1.5rem;
				font-size: 0.85rem;
			}

			/* Prose Content */
			.prose-wrapper {
				max-width: 760px;
			}

			.prose {
				color: var(--ov-on-surface-var);
				font-size: 1.05rem;
				line-height: 1.8;
			}

			.prose :global(h2) {
				font-family: 'Space Grotesk', sans-serif;
				font-size: 1.6rem;
				font-weight: 700;
				letter-spacing: -0.03em;
				color: var(--ov-on-surface);
				margin: 2.5rem 0 1rem;
				scroll-margin-top: 100px;
			}

			.prose :global(h3) {
				font-family: 'Space Grotesk', sans-serif;
				font-size: 1.2rem;
				font-weight: 600;
				color: var(--ov-on-surface);
				margin: 2rem 0 0.75rem;
				scroll-margin-top: 100px;
			}

			.prose :global(p) {
				margin: 0 0 1.4rem;
				color: var(--ov-on-surface-var);
			}

			.prose :global(strong) {
				color: var(--ov-on-surface);
				font-weight: 600;
			}

			.prose :global(a) {
				color: var(--ov-primary);
				text-decoration: none;
				border-bottom: 1px solid rgba(105, 218, 255, 0.3);
				transition: border-color 0.2s;
			}

			.prose :global(a:hover) {
				border-color: var(--ov-primary);
			}

			.prose :global(hr) {
				border: none;
				border-top: 1px solid rgba(71, 70, 85, 0.4);
				margin: 2.5rem 0;
			}

			.prose :global(ul), .prose :global(ol) {
				padding-left: 1.5rem;
				margin: 0 0 1.4rem;
			}

			.prose :global(li) {
				margin-bottom: 0.5rem;
			}

			.prose :global(blockquote) {
				margin: 2rem 0;
				padding: 1.25rem 1.5rem;
				background: var(--ov-surface-mid);
				border-left: 3px solid var(--ov-primary);
				border-radius: 0 8px 8px 0;
				color: var(--ov-on-surface);
				font-style: italic;
			}

			.prose :global(code) {
				background: var(--ov-surface-mid);
				color: var(--ov-primary);
				padding: 0.2em 0.45em;
				border-radius: 4px;
				font-size: 0.9em;
			}

			/* Related Posts */
			.related-posts {
				margin-top: 3rem;
				padding: 1.5rem;
				background: var(--ov-surface-mid);
				border-radius: 12px;
				border: 1px solid rgba(105, 218, 255, 0.1);
			}

			.related-posts h3 {
				font-family: 'Space Grotesk', sans-serif;
				font-size: 1.1rem;
				color: var(--ov-on-surface);
				margin-bottom: 1rem;
			}

			.related-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 1rem;
			}

			.related-card {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				padding: 1rem;
				background: var(--ov-surface-low);
				border-radius: 8px;
				text-decoration: none;
				border: none;
				transition: all 0.2s;
			}

			.related-card:hover {
				background: var(--ov-surface-high);
				transform: translateY(-2px);
			}

			.related-card .related-title {
				font-weight: 600;
				font-size: 0.9rem;
				color: var(--ov-on-surface);
				line-height: 1.4;
			}

			.related-card .related-cat {
				font-size: 0.75rem;
				color: var(--ov-primary);
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}

			/* CTAs */
			.post-ctas {
				margin-top: 2.5rem;
				text-align: center;
				padding: 2rem;
				background: linear-gradient(135deg, rgba(105, 218, 255, 0.08), rgba(172, 137, 255, 0.08));
				border-radius: 16px;
				border: 1px solid rgba(105, 218, 255, 0.15);
			}

			.post-ctas h3 {
				font-family: 'Space Grotesk', sans-serif;
				font-size: 1.3rem;
				color: var(--ov-on-surface);
				margin-bottom: 1rem;
			}

			.post-ctas p {
				color: var(--ov-on-surface-var);
				margin-bottom: 1.5rem;
			}

			.cta-buttons {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				justify-content: center;
			}

			.cta-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.75rem 1.5rem;
				border-radius: 9999px;
				text-decoration: none;
				font-weight: 600;
				font-size: 0.95rem;
				border: none;
				cursor: pointer;
				transition: all 0.2s;
			}

			.cta-btn:hover {
				transform: scale(1.04);
			}

			.cta-btn-primary {
				background: linear-gradient(135deg, var(--ov-primary), var(--ov-secondary));
				color: #003d4d;
			}

			.cta-btn-secondary {
				background: #25d366;
				color: #000;
			}

			.cta-btn-ghost {
				background: var(--ov-surface-mid);
				color: var(--ov-on-surface);
				border: 1px solid rgba(255, 255, 255, 0.1);
			}

			/* Share Bar */
			.share-bar {
				margin-top: 2.5rem;
				padding: 1.5rem;
				background: var(--ov-surface-mid);
				border-radius: 12px;
				border: 1px solid rgba(71, 70, 85, 0.5);
				display: flex;
				align-items: center;
				gap: 1rem;
				flex-wrap: wrap;
			}

			.share-label {
				font-family: 'Space Grotesk', sans-serif;
				font-size: 0.85rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--ov-on-surface-var);
				white-space: nowrap;
			}

			.share-buttons {
				display: flex;
				gap: 0.75rem;
				flex-wrap: wrap;
			}

			.share-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				padding: 0.55rem 1.1rem;
				border-radius: 9999px;
				text-decoration: none;
				font-weight: 600;
				font-size: 0.88rem;
				transition: all 0.2s;
				cursor: pointer;
				border: none;
			}

			.share-btn:hover { transform: scale(1.05); opacity: 0.92; }

			.share-whatsapp { background: #25d366; color: #000; }
			.share-facebook { background: #1877f2; color: #fff; }
			.share-twitter  { background: #000; color: #fff; }
			.share-copy     { background: var(--ov-surface-high); color: var(--ov-on-surface); border: 1px solid rgba(255,255,255,0.1); }

			/* Comments Section */
			.comments-section {
				margin-top: 3rem;
				padding-top: 3rem;
				border-top: 1px solid rgba(71, 70, 85, 0.3);
			}

			.comments-title {
				font-family: 'Space Grotesk', sans-serif;
				font-size: 1.3rem;
				color: var(--ov-on-surface);
				margin-bottom: 1.5rem;
				text-align: center;
			}

			@keyframes fadeInUp {
				from { opacity: 0; transform: translateY(24px); }
				to   { opacity: 1; transform: translateY(0); }
			}

			@media (max-width: 768px) {
				.hero-section { min-height: 80vh; }
				.post-header { padding: 1.5rem; }
				.toc-sidebar { display: none; }
				.content-layout { grid-template-columns: 1fr; }
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<!-- Breadcrumb nav -->
			<nav class="breadcrumb" aria-label="Ruta de navegación">
				<div class="breadcrumb-inner">
					<a href="/">Inicio</a>
					<span class="breadcrumb-sep" aria-hidden="true">/</span>
					<a href="/blog">Blog</a>
					<span class="breadcrumb-sep" aria-hidden="true">/</span>
					{category && (
						<>
							<span class="breadcrumb-cat">{category}</span>
							<span class="breadcrumb-sep" aria-hidden="true">/</span>
						</>
					)}
					<span class="breadcrumb-current" aria-current="page">{title}</span>
				</div>
			</nav>

			<article>
				<!-- Hero Section -->
				<div class="hero-section">
					{heroImage && <Image width={1920} height={1080} src={heroImage} alt={optimizedAlt} loading="eager" decoding="async" />}
					<div class="post-header">
						<!-- Category & Date -->
						<div class="post-meta">
							{category && <span>{category}</span>}
							{category && <span class="dot"></span>}
							<span class="date"><FormattedDate date={pubDate} /></span>
						</div>

						<!-- Reading Time -->
						<div class="reading-time">
							⏱️ {readingTime} min de lectura
						</div>

						<!-- Title -->
						<h1>{title}</h1>

						<!-- Author -->
						<div class="author-badge">
							✍️ <span class="author-name">{postAuthor.name}</span>
							{postAuthor.since && (
								<span class="author-since">Rider desde {postAuthor.since}</span>
							)}
						</div>

						<!-- Updated Date -->
						{isUpdated && (
							<div class="updated-badge">
								🔄 Actualizado: <FormattedDate date={updatedDate!} />
							</div>
						)}
					</div>
				</div>

				<!-- Content Layout with TOC -->
				<div class="content-layout">
					<!-- TOC Sidebar -->
					<aside class="toc-sidebar">
						<div class="toc-container">
							<div class="toc-title">📑 Contenido</div>
							<ul class="toc-list" id="toc-list">
								<!-- TOC items will be populated by JavaScript -->
								<li><a href="#">Cargando...</a></li>
							</ul>
						</div>
					</aside>

					<!-- Main Content -->
					<div class="prose-wrapper">
						<div class="prose" id="article-content">
							<slot />
						</div>

						<!-- Related Posts (Dynamic) -->
						{relatedPosts.length > 0 && (
							<div class="related-posts">
								<h3>📚 También te puede interesar</h3>
								<div class="related-grid">
									{relatedPosts.map((post) => (
										<a href={`/blog/${post.id}/`} class="related-card">
											<span class="related-cat">{(post.data as any).category || 'General'}</span>
											<span class="related-title">{post.data.title}</span>
										</a>
									))}
									</div>
								</div>
							)}

						<!-- Share Bar -->
						<div class="share-bar">
							<span class="share-label">Compartir</span>
							<div class="share-buttons">
								<a id="share-whatsapp" class="share-btn share-whatsapp" target="_blank" rel="noopener">
