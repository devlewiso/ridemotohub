---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead
            title="Nosotros - RideMotoHub Guatemala"
            description="Conoce la historia, misión y valores de RideMotoHub Guatemala. La comunidad que une a todos los riders del país."
        />
    </head>
    <body>
        <Header />

        <!-- ── Hero ── -->
        <section class="page-hero">
            <div class="hero-content">
                <span class="hero-badge">🏍️ Nosotros</span>
                <h1>La familia<br /><span class="gradient-text">RideMotoHub</span></h1>
                <p>Uniendo a todos los riders de Guatemala desde 2024 — sin importar cilindrada, marca ni experiencia.</p>
            </div>
        </section>

        <!-- ── Misión ── -->
        <section class="mission-section">
            <div class="container">
                <span class="section-label">Misión</span>
                <blockquote>
                    "Crear la comunidad motera más inclusiva y activa de Guatemala, donde riders de todas las cilindradas se unan para compartir su pasión, promoviendo la seguridad vial, el respeto mutuo y la hermandad entre motociclistas."
                </blockquote>
            </div>
        </section>

        <!-- ── Stats ── -->
        <section class="stats-section">
            <div class="container">
                <div class="stats-grid">
                    <div class="stat">
                        <span class="stat-number gradient-text">2024</span>
                        <span class="stat-label">Año de fundación</span>
                    </div>
                    <div class="stat">
                        <span class="stat-number gradient-text">125cc+</span>
                        <span class="stat-label">Todas las cilindradas</span>
                    </div>
                    <div class="stat">
                        <span class="stat-number gradient-text">GT</span>
                        <span class="stat-label">100% guatemalteco</span>
                    </div>
                    <div class="stat">
                        <span class="stat-number gradient-text">∞</span>
                        <span class="stat-label">Kilómetros por recorrer</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── Valores ── -->
        <section class="values-section">
            <div class="container">
                <div class="section-header">
                    <span class="section-label">Valores</span>
                    <h2>Lo que nos define</h2>
                </div>
                <div class="values-grid">
                    <div class="value-card">
                        <div class="value-icon">🤝</div>
                        <h3>Inclusividad</h3>
                        <p>Desde 125cc hasta 1000cc+, todos somos parte de la misma familia motera. No hay jerarquías en dos ruedas.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon">🛡️</div>
                        <h3>Seguridad</h3>
                        <p>Promovemos la conducción responsable y el uso de equipo de protección en todas nuestras actividades.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon">❤️</div>
                        <h3>Hermandad</h3>
                        <p>Cuando uno cae, todos nos detenemos. El rider nunca queda solo en carretera — somos familia.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon">🌟</div>
                        <h3>Respeto</h3>
                        <p>Respeto hacia otros riders, hacia la carretera y hacia todos los usuarios de la vía pública.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon">🎓</div>
                        <h3>Educación</h3>
                        <p>Compartimos conocimiento sobre mantenimiento, técnicas de conducción y seguridad vial continuamente.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon">🌍</div>
                        <h3>Comunidad</h3>
                        <p>Fomentamos el sentido de pertenencia y la participación activa de todos los miembros del grupo.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── Historia ── -->
        <section class="story-section">
            <div class="container">
                <div class="story-layout">
                    <div class="story-aside">
                        <span class="section-label">Historia</span>
                        <h2>Cómo empezó todo</h2>
                        <div class="story-timeline">
                            <div class="timeline-item">
                                <span class="timeline-year">2024</span>
                                <span class="timeline-event">Fundación del grupo</span>
                            </div>
                            <div class="timeline-item">
                                <span class="timeline-year">2024</span>
                                <span class="timeline-event">Primera rodada oficial</span>
                            </div>
                            <div class="timeline-item">
                                <span class="timeline-year">Ene 2026</span>
                                <span class="timeline-event">Lanzamiento del sitio web</span>
                            </div>
                            <div class="timeline-item active">
                                <span class="timeline-year">Hoy</span>
                                <span class="timeline-event">Comunidad en crecimiento</span>
                            </div>
                        </div>
                    </div>
                    <div class="story-body">
                        <p>RideMotoHub nació en 2024 con una visión clara: crear un espacio donde todos los motociclistas de Guatemala pudieran conectarse, sin importar la marca o cilindrada de su moto.</p>
                        <p>Comenzamos como un pequeño grupo de amigos que compartían la pasión por las motos y las rutas de Guatemala. Con el tiempo, nos dimos cuenta de que había una necesidad real de una comunidad inclusiva que celebrara la diversidad de riders en nuestro país.</p>
                        <p>Hoy somos una comunidad en crecimiento que organiza rodadas, eventos, talleres y comparte información valiosa sobre rutas, mantenimiento y seguridad vial. Nuestro objetivo es seguir creciendo y uniendo a más riders cada día.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── ¿Qué hacemos? ── -->
        <section class="activities-section">
            <div class="container">
                <div class="section-header">
                    <span class="section-label">Actividades</span>
                    <h2>¿Qué hacemos?</h2>
                </div>
                <div class="activities-grid">
                    <div class="activity-card">
                        <span class="activity-icon">🗺️</span>
                        <h3>Rodadas organizadas</h3>
                        <p>Organizamos rodadas grupales a las mejores rutas de Guatemala, desde paseos cortos hasta expediciones de varios días.</p>
                    </div>
                    <div class="activity-card">
                        <span class="activity-icon">📅</span>
                        <h3>Eventos comunitarios</h3>
                        <p>Encuentros mensuales, talleres de mantenimiento, charlas de seguridad y eventos benéficos para comunidades.</p>
                    </div>
                    <div class="activity-card">
                        <span class="activity-icon">💡</span>
                        <h3>Compartir conocimiento</h3>
                        <p>Publicamos tips, consejos y guías sobre mantenimiento, técnicas de conducción y las mejores rutas del país.</p>
                    </div>
                    <div class="activity-card">
                        <span class="activity-icon">🤝</span>
                        <h3>Red de apoyo</h3>
                        <p>Una red de riders que comparten recomendaciones de talleres, repuestos y asistencia en carretera cuando se necesita.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── Transparencia + Privacidad ── -->
        <section class="info-section">
            <div class="container">
                <div class="info-grid">
                    <div class="info-card ai-card">
                        <span class="info-icon">🤖</span>
                        <h3>Transparencia con IA</h3>
                        <p>Parte del contenido de este sitio es creado o mejorado con inteligencia artificial para ofrecerte la mejor experiencia posible. Todo contenido generado con IA está claramente marcado:</p>
                        <span class="ai-badge">🤖 Creado con Inteligencia Artificial</span>
                        <p class="info-note">Toda la información es revisada por riders experimentados antes de publicarse.</p>
                    </div>
                    <div class="info-card privacy-card">
                        <span class="info-icon">🔒</span>
                        <h3>Tu privacidad importa</h3>
                        <p>RideMotoHub respeta tu privacidad. Solo compartimos información pública relacionada con eventos, rutas y contenido comunitario.</p>
                        <ul class="privacy-list">
                            <li>No vendemos datos personales</li>
                            <li>No compartimos info privada sin consentimiento</li>
                            <li>Cumplimos con GDPR y leyes de privacidad</li>
                            <li>Cookies solo para mejorar la experiencia</li>
                        </ul>
                        <div class="info-links">
                            <a href="/privacidad">Política de Privacidad</a>
                            <a href="/terminos">Términos de Uso</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── CTA Comunidad ── -->
        <section class="cta-section">
            <div class="container">
                <div class="cta-box">
                    <h2>Únete a la familia</h2>
                    <p>¿Listo para formar parte de RideMotoHub? Síguenos en redes y únete a nuestros grupos.</p>
                    <div class="cta-buttons">
                        <a href="https://www.instagram.com/ridemotohub" target="_blank" rel="noopener noreferrer" class="btn btn-instagram">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                            Instagram
                        </a>
                        <a href="https://www.facebook.com/ridemotohub" target="_blank" rel="noopener noreferrer" class="btn btn-facebook">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                            Facebook
                        </a>
                        <a href="https://chat.whatsapp.com/ridemotohub" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                            WhatsApp
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <Footer />
    </body>
</html>

<style is:global>
    :root {
        --ov-primary:        #69daff;
        --ov-secondary:      #ac89ff;
        --ov-tertiary:       #ff5dd7;
        --ov-bg:             #0d0d19;
        --ov-surface-low:    #121220;
        --ov-surface-mid:    #181827;
        --ov-surface-high:   #1e1e2f;
        --ov-surface-top:    #242436;
        --ov-on-surface:     #e9e6f9;
        --ov-on-surface-var: #aba9ba;
        --ov-outline-var:    #474655;
    }
    main {
        width: 100% !important;
        max-width: 100% !important;
        padding: 0 !important;
    }
    body {
        margin: 0 !important;
        padding: 0 !important;
        background: #0d0d19 !important;
        background-image: none !important;
        font-size: 16px !important;
        color: #e9e6f9 !important;
    }
</style>

<style>
    body {
        background: var(--ov-bg);
        color: var(--ov-on-surface);
        font-family: 'Manrope', sans-serif;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .gradient-text {
        background: linear-gradient(135deg, #69daff, #ac89ff, #ff5dd7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .section-label {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ov-primary);
        margin-bottom: 0.75rem;
    }

    .section-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .section-header h2 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(1.75rem, 3.5vw, 2.5rem);
        font-weight: 900;
        letter-spacing: -0.04em;
        color: var(--ov-on-surface);
        margin: 0;
    }

    /* ── Hero ── */
    .page-hero {
        background: var(--ov-surface-low);
        padding: 8rem 2rem 6rem;
        text-align: center;
        margin-top: -64px;
        padding-top: calc(8rem + 64px);
    }

    .hero-content {
        max-width: 720px;
        margin: 0 auto;
    }

    .hero-badge {
        display: inline-block;
        padding: 0.35rem 1rem;
        background: rgba(105, 218, 255, 0.08);
        border: 1px solid rgba(105, 218, 255, 0.25);
        border-radius: 9999px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--ov-primary);
        margin-bottom: 1.5rem;
    }

    .page-hero h1 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(2.75rem, 6vw, 4.5rem);
        font-weight: 900;
        letter-spacing: -0.04em;
        line-height: 1.05;
        margin: 0 0 1.25rem;
        color: var(--ov-on-surface);
    }

    .page-hero p {
        font-size: 1.1rem;
        color: var(--ov-on-surface-var);
        line-height: 1.7;
        margin: 0;
        max-width: 560px;
        margin: 0 auto;
    }

    /* ── Misión ── */
    .mission-section {
        background: var(--ov-bg);
        padding: 5rem 0;
    }

    .mission-section .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    blockquote {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(1.1rem, 2.5vw, 1.5rem);
        font-weight: 500;
        line-height: 1.65;
        color: var(--ov-on-surface);
        text-align: center;
        max-width: 860px;
        margin: 0;
        padding: 2.5rem 3rem;
        background: var(--ov-surface-mid);
        border-radius: 20px;
        border-left: 4px solid var(--ov-primary);
        position: relative;
    }

    blockquote::before {
        content: '"';
        position: absolute;
        top: -0.5rem;
        left: 2rem;
        font-size: 5rem;
        line-height: 1;
        color: var(--ov-primary);
        opacity: 0.2;
        font-family: Georgia, serif;
    }

    /* ── Stats ── */
    .stats-section {
        background: var(--ov-surface-top);
        padding: 4rem 0;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
    }

    .stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
        padding: 1.5rem;
        border-right: 1px solid rgba(71, 70, 85, 0.25);
    }

    .stat:last-child { border-right: none; }

    .stat-number {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(2rem, 4vw, 2.75rem);
        font-weight: 900;
        letter-spacing: -0.03em;
        line-height: 1;
    }

    .stat-label {
        font-size: 0.82rem;
        color: var(--ov-on-surface-var);
        text-align: center;
    }

    /* ── Valores ── */
    .values-section {
        background: var(--ov-bg);
        padding: 5rem 0;
    }

    .values-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
    }

    .value-card {
        background: var(--ov-surface-mid);
        border-radius: 16px;
        padding: 2rem 1.75rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
    }

    .value-card:hover {
        transform: translateY(-4px);
        background: var(--ov-surface-high);
        box-shadow: 0 16px 32px rgba(105, 218, 255, 0.08);
    }

    .value-icon {
        font-size: 2rem;
        display: block;
        margin-bottom: 1rem;
    }

    .value-card h3 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--ov-on-surface);
        margin: 0 0 0.6rem;
    }

    .value-card p {
        font-size: 0.875rem;
        color: var(--ov-on-surface-var);
        line-height: 1.65;
        margin: 0;
    }

    /* ── Historia ── */
    .story-section {
        background: var(--ov-surface-low);
        padding: 5rem 0;
    }

    .story-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 4rem;
        align-items: start;
    }

    .story-aside h2 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 900;
        letter-spacing: -0.04em;
        color: var(--ov-on-surface);
        margin: 0 0 2rem;
    }

    .story-timeline {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .timeline-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.85rem 0;
        border-bottom: 1px solid rgba(71, 70, 85, 0.2);
    }

    .timeline-item:last-child { border-bottom: none; }

    .timeline-year {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--ov-on-surface-var);
        min-width: 50px;
    }

    .timeline-item.active .timeline-year {
        color: var(--ov-primary);
    }

    .timeline-event {
        font-size: 0.875rem;
        color: var(--ov-on-surface-var);
    }

    .timeline-item.active .timeline-event {
        color: var(--ov-on-surface);
        font-weight: 600;
    }

    .story-body p {
        font-size: 1rem;
        line-height: 1.8;
        color: var(--ov-on-surface-var);
        margin: 0 0 1.25rem;
    }

    .story-body p:last-child { margin-bottom: 0; }

    /* ── Actividades ── */
    .activities-section {
        background: var(--ov-bg);
        padding: 5rem 0;
    }

    .activities-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.25rem;
    }

    .activity-card {
        background: var(--ov-surface-mid);
        border-radius: 16px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        transition: transform 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
    }

    .activity-card:hover {
        transform: translateY(-4px);
        background: var(--ov-surface-high);
        box-shadow: 0 16px 32px rgba(172, 137, 255, 0.08);
    }

    .activity-icon {
        font-size: 2rem;
    }

    .activity-card h3 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--ov-on-surface);
        margin: 0;
    }

    .activity-card p {
        font-size: 0.875rem;
        color: var(--ov-on-surface-var);
        line-height: 1.65;
        margin: 0;
    }

    /* ── Info (IA + Privacy) ── */
    .info-section {
        background: var(--ov-surface-low);
        padding: 5rem 0;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .info-card {
        background: var(--ov-surface-mid);
        border-radius: 16px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

