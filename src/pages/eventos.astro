---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead
            title="Eventos - RideMotoHub Guatemala"
            description="Descubre los próximos eventos, rodadas y encuentros de la comunidad motera de Guatemala. Únete a la familia RideMotoHub."
        />
    </head>
    <body>
        <Header />

        <!-- Hero -->
        <section class="page-hero">
            <div class="hero-content">
                <span class="hero-badge">📅 Eventos</span>
                <h1>Eventos <span class="gradient-text">&amp; Rodadas</span></h1>
                <p>Únete a las rodadas, encuentros y eventos de la comunidad motera más grande de Guatemala.</p>
            </div>
        </section>

                <!-- Próximos eventos -->
                <section class="events-section">
            <div class="container">

                <div class="section-header">
                    <span class="section-label">Próximos eventos</span>
                    <h2>No te quedes fuera</h2>
                </div>

                <!-- Caravana del Zorro — evento destacado -->
                <article class="event-featured">
                    <div class="event-date-block">
                        <span class="date-day">07</span>
                        <span class="date-month">FEB</span>
                        <span class="date-year">2026</span>
                    </div>
                    <div class="event-body">
                        <div class="event-top">
                            <span class="event-flag">🔥 Próximo evento</span>
                            <span class="event-free">Entrada libre</span>
                        </div>
                        <h3>🦊 Caravana del Zorro — Guatemala 2026</h3>
                        <div class="event-meta">
                            <span class="meta-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                                Ciudad de Guatemala
                            </span>
                            <span class="meta-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
                                7:00 AM
                            </span>
                            <span class="meta-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                                Evento masivo
                            </span>
                        </div>
                        <p>¡El evento motero más grande de Guatemala! La legendaria Caravana del Zorro regresa este primer fin de semana de febrero. Miles de riders, música en vivo, comida y mucho más.</p>
                        <div class="event-tags">
                            <span class="tag">🏍️ Miles de Riders</span>
                            <span class="tag">🎵 Música en Vivo</span>
                            <span class="tag">🍔 Food Trucks</span>
                            <span class="tag">🏆 Sorteos</span>
                        </div>
                        <a href="/eventos/caravana-del-zorro-2026" class="btn-primary">
                            Ver detalles
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
                        </a>
                    </div>
                </article>

                <!-- Más eventos próximos -->
                <div class="events-grid">
                    <article class="event-card">
                        <div class="event-date-badge">
                            <span class="month">MAR</span>
                            <span class="day">15</span>
                        </div>
                        <div class="event-card-content">
                            <span class="event-type">🏔️ Rodada</span>
                            <h4>Ruta al Volcán de Fuego</h4>
                            <p class="event-location"> Antigua Guatemala → Escuintla</p>
                            <p class="event-desc">Rueda hacia uno de los volcanes más activos de Guatemala. Vista espectaculares y mucha adrenalina.</p>
                            <span class="event-participants">60 riders confirmados</span>
                        </div>
                    </article>

                    <article class="event-card">
                        <div class="event-date-badge">
                            <span class="month">MAR</span>
                            <span class="day">29</span>
                        </div>
                        <div class="event-card-content">
                            <span class="event-type">🎉 Meetup</span>
                            <h4>Motoencuentro Xela</h4>
                            <p class="event-location">Quetzaltenango</p>
                            <p class="event-desc">El encuentro mensual de riders del altiplano. Música, comida y networking motero.</p>
                            <span class="event-participants">120 riders confirmados</span>
                        </div>
                    </article>

                    <article class="event-card">
                        <div class="event-date-badge">
                            <span class="month">ABR</span>
                            <span class="day">12</span>
                        </div>
                        <div class="event-card-content">
                            <span class="event-type">🌊 Rodada</span>
                            <h4>Ruta a Monterrico</h4>
                            <p class="event-location">Ciudad Guatemala → Monterrico</p>
                            <p class="event-desc">Rodea hacia la costa pacífica. Playa, mariscos frescos y atardecer frente al mar.</p>
                            <span class="event-participants">85 riders confirmados</span>
                        </div>
                    </article>

                    <article class="event-card">
                        <div class="event-date-badge">
                            <span class="month">ABR</span>
                            <span class="day">26</span>
                        </div>
                        <div class="event-card-content">
                            <span class="event-type">🏆 Competencia</span>
                            <h4>Enduro Championship GT</h4>
                            <p class="event-location">San Pedro La Laguna</p>
                            <p class="event-desc">Competencia de enduro autour del lago Atitlán. Todas las cilindradas bienvenidas.</p>
                            <span class="event-participants">45 competidores</span>
                        </div>
                    </article>

                    <article class="event-card">
                        <div class="event-date-badge">
                            <span class="month">MAY</span>
                            <span class="day">03</span>
                        </div>
                        <div class="event-card-content">
                            <span class="event-type">❤️ Caravana</span>
                            <h4>Rodada Solidaria Petén</h4>
                            <p class="event-location">Ciudad Guatemala → Flores</p>
                            <p class="event-desc">Caravana benéfica llevando donaciones a comunidades necesitadas del norte. ¡Únete!</p>
                            <span class="event-participants">40 riders confirmados</span>
                        </div>
                    </article>

                    <article class="event-card">
                        <div class="event-date-badge">
                            <span class="month">MAY</span>
                            <span class="day">17</span>
                        </div>
                        <div class="event-card-content">
                            <span class="event-type">🎤 Evento</span>
                            <h4>Moto Fest Guatemala</h4>
                            <p class="event-location">Zona 10, Guatemala City</p>
                            <p class="event-desc">Festival de música, stunt shows, custom bikes y mercado de partes. El evento del año.</p>
                            <span class="event-participants">500+ asistentes</span>
                        </div>
                    </article>
                </div>

                <!-- Eventos pasados -->
                <div class="past-section">
                    <div class="section-header">
                        <span class="section-label">Historial</span>
                        <h2>Eventos pasados</h2>
                    </div>
                    <div class="past-grid">
                        <div class="past-card">
                            <div class="past-thumb past-thumb-1"></div>
                            <div class="past-info">
                                <h4>Rodada a Antigua Guatemala</h4>
                                <p>Enero 2026</p>
                                <span class="riders-count">45 riders</span>
                            </div>
                        </div>
                        <div class="past-card">
                            <div class="past-thumb past-thumb-2"></div>
                            <div class="past-info">
                                <h4>Encuentro Anual 2025</h4>
                                <p>Diciembre 2025</p>
                                <span class="riders-count">120 riders</span>
                            </div>
                        </div>
                        <div class="past-card">
                            <div class="past-thumb past-thumb-3"></div>
                            <div class="past-info">
                                <h4>Rodada a Monterrico</h4>
                                <p>Noviembre 2025</p>
                                <span class="riders-count">60 riders</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CTA -->
                <div class="cta-box">
                    <h3>¿Quieres organizar un evento?</h3>
                    <p>Si tienes una idea para una rodada o evento, contáctanos y lo organizamos juntos.</p>
                    <a href="/blog" class="btn-cta">Proponer evento</a>
                </div>

            </div>
        </section>

        <Footer />
    </body>
</html>

<style is:global>
    :root {
        --ov-primary:        #69daff;
        --ov-secondary:      #ac89ff;
        --ov-tertiary:       #ff5dd7;
        --ov-bg:             #0d0d19;
        --ov-surface-low:    #121220;
        --ov-surface-mid:    #181827;
        --ov-surface-high:   #1e1e2f;
        --ov-surface-top:    #242436;
        --ov-on-surface:     #e9e6f9;
        --ov-on-surface-var: #aba9ba;
        --ov-outline-var:    #474655;
    }
    main { width: 100% !important; max-width: 100% !important; padding: 0 !important; }
    body {
        margin: 0 !important; padding: 0 !important;
        background: #0d0d19 !important;
        background-image: none !important;
        font-size: 16px !important;
        color: #e9e6f9 !important;
    }
</style>

<style>
    body {
        background: var(--ov-bg);
        color: var(--ov-on-surface);
        font-family: 'Manrope', sans-serif;
    }

    .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .gradient-text {
        background: linear-gradient(135deg, #69daff, #ac89ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .section-label {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ov-primary);
        margin-bottom: 0.5rem;
    }

    .section-header {
        text-align: center;
        margin-bottom: 2.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .section-header h2 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        font-weight: 900;
        letter-spacing: -0.04em;
        color: var(--ov-on-surface);
        margin: 0;
    }

    /* ── Hero ── */
    .page-hero {
        background: var(--ov-surface-low);
        padding: 8rem 2rem 5rem;
        text-align: center;
        margin-top: -64px;
        padding-top: calc(7rem + 64px);
    }

    .hero-content { max-width: 640px; margin: 0 auto; }

    .hero-badge {
        display: inline-block;
        padding: 0.35rem 1rem;
        background: rgba(105, 218, 255, 0.08);
        border: 1px solid rgba(105, 218, 255, 0.25);
        border-radius: 9999px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--ov-primary);
        margin-bottom: 1.5rem;
    }

    .page-hero h1 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 900;
        letter-spacing: -0.04em;
        line-height: 1.05;
        margin: 0 0 1.25rem;
        color: var(--ov-on-surface);
    }

    .page-hero p {
        font-size: 1.05rem;
        color: var(--ov-on-surface-var);
        line-height: 1.7;
        margin: 0 auto;
        max-width: 480px;
    }

    /* ── Events Section ── */
    .events-section {
        background: var(--ov-bg);
        padding: 5rem 0;
    }

    /* Evento destacado */
    .event-featured {
        background: var(--ov-surface-mid);
        border: 1px solid rgba(105, 218, 255, 0.1);
        border-radius: 20px;
        padding: 2.5rem;
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 2.5rem;
        align-items: start;
        margin-bottom: 4rem;
        box-shadow: 0 8px 40px rgba(105, 218, 255, 0.06);
    }

    .event-date-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: var(--ov-surface-top);
        border-radius: 16px;
        padding: 1.5rem 1rem;
        text-align: center;
        border: 1px solid rgba(105, 218, 255, 0.1);
    }

    .date-day {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 3rem;
        font-weight: 900;
        line-height: 1;
        background: linear-gradient(135deg, #69daff, #ac89ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .date-month {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: var(--ov-on-surface);
        margin-top: 0.25rem;
    }

    .date-year {
        font-size: 0.75rem;
        color: var(--ov-on-surface-var);
        margin-top: 0.2rem;
    }

    .event-top {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }

    .event-flag {
        display: inline-block;
        padding: 0.3rem 0.85rem;
        background: rgba(255, 93, 215, 0.1);
        border: 1px solid rgba(255, 93, 215, 0.25);
        border-radius: 9999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ov-tertiary);
    }

    .event-free {
        display: inline-block;
        padding: 0.3rem 0.85rem;
        background: rgba(105, 218, 100, 0.1);
        border: 1px solid rgba(105, 218, 100, 0.25);
        border-radius: 9999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #69da64;
    }

    .event-body h3 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(1.3rem, 2.5vw, 1.75rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--ov-on-surface);
        margin: 0 0 1rem;
        line-height: 1.2;
    }

    .event-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        color: var(--ov-on-surface-var);
    }

    .meta-item svg { opacity: 0.6; flex-shrink: 0; }

    .event-body p {
        font-size: 0.9rem;
        color: var(--ov-on-surface-var);
        line-height: 1.7;
        margin: 0 0 1.5rem;
    }

    .event-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 2rem;
    }

    .tag {
        display: inline-block;
        padding: 0.3rem 0.85rem;
        background: rgba(71, 70, 85, 0.4);
        border-radius: 9999px;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--ov-on-surface-var);
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.75rem;
        background: linear-gradient(135deg, var(--ov-primary), var(--ov-secondary));
        color: #003d4d;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 0.9rem;
        border-radius: 9999px;
        text-decoration: none;
        box-shadow: 0 4px 16px rgba(105, 218, 255, 0.2);
        transition: opacity 0.2s, transform 0.2s;
    }

    .btn-primary:hover { opacity: 0.9; transform: translateY(-2px); }

    .btn-primary svg { transition: transform 0.2s; }
    .btn-primary:hover svg { transform: translateX(4px); }

    /* ── Pasados ── */
    .past-section { margin-bottom: 4rem; }

    .past-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
    }

    .past-card {
        background: var(--ov-surface-mid);
        border-radius: 14px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .past-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(172, 137, 255, 0.08);
    }

    .past-thumb {
        height: 140px;
        background-size: cover;
        background-position: center;
    }

    .past-thumb-1 { background: linear-gradient(135deg, rgba(105,218,255,0.3), rgba(172,137,255,0.3)), var(--ov-surface-top); }
    .past-thumb-2 { background: linear-gradient(135deg, rgba(172,137,255,0.3), rgba(255,93,215,0.3)), var(--ov-surface-top); }
    .past-thumb-3 { background: linear-gradient(135deg, rgba(105,218,255,0.2), rgba(105,218,100,0.2)), var(--ov-surface-top); }

    .past-info {
        padding: 1.25rem;
    }

    .past-info h4 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--ov-on-surface);
        margin: 0 0 0.35rem;
    }

    .past-info p {
        font-size: 0.8rem;
        color: var(--ov-on-surface-var);
        margin: 0 0 0.5rem;
    }

    .riders-count {
        display: inline-block;
        padding: 0.2rem 0.65rem;
        background: rgba(105, 218, 255, 0.08);
        border: 1px solid rgba(105, 218, 255, 0.2);
        border-radius: 9999px;
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--ov-primary);
    }

    /* CTA */
    .cta-box {
        background: var(--ov-surface-top);
        border: 1px solid rgba(105, 218, 255, 0.1);
        border-radius: 20px;
        padding: 3.5rem;
        text-align: center;
        box-shadow: 0 8px 40px rgba(105, 218, 255, 0.05);
    }

    .cta-box h3 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 900;
        letter-spacing: -0.03em;
        color: var(--ov-on-surface);
        margin: 0 0 0.75rem;
    }

    .cta-box p {
        font-size: 1rem;
        color: var(--ov-on-surface-var);
        margin: 0 0 2rem;
        line-height: 1.7;
    }

    .btn-cta {
        display: inline-flex;
        align-items: center;
        padding: 0.85rem 2rem;
        background: linear-gradient(135deg, var(--ov-primary), var(--ov-secondary));
        color: #003d4d;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 0.95rem;
        border-radius: 9999px;
        text-decoration: none;
        box-shadow: 0 4px 20px rgba(105, 218, 255, 0.2);
        transition: opacity 0.2s, transform 0.2s;
    }

    .btn-cta:hover { opacity: 0.9; transform: translateY(-2px); }

    /* Responsive */
    @media (max-width: 768px) {
        .event-featured {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .event-date-block {
            flex-direction: row;
            gap: 0.75rem;
            padding: 1rem 1.5rem;
            justify-content: center;
            align-items: baseline;
        }

        .date-day { font-size: 2rem; }

        .past-grid { grid-template-columns: 1fr; }

        .cta-box { padding: 2.5rem 1.5rem; }
    }
</style>
