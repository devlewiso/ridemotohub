---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const recentPosts = (await getCollection("blog"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<!-- Hero Section -->
		<section class="hero">
			<div class="hero-content">
				<div class="hero-badge">🏍️ Guatemala</div>
				<h1 class="hero-title">
					<span class="gradient-text">RideMotoHub</span>
					<span class="hero-title-tagline">La comunidad motera más grande de Guatemala</span>
				</h1>
				<p class="hero-description">
					Desde 125cc hasta 1000cc+, todos somos parte de la misma
					familia. Únete a la comunidad motera más grande de
					Guatemala.
				</p>
				<div class="hero-cta">
					<a href="/blog" class="btn btn-primary">
						<span>Explorar Blog</span>
						<svg
							width="20"
							height="20"
							viewBox="0 0 20 20"
							fill="none"
						>
							<path
								d="M7.5 15L12.5 10L7.5 5"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</a>
					<a href="/about" class="btn btn-secondary">Conoce Más</a>
				</div>
				<div class="hero-quick-links">
					<a href="/rutas" class="quick-link">🗺️ Rutas</a>
					<a href="/eventos" class="quick-link">📅 Eventos</a>
					<a href="/tips" class="quick-link">💡 Tips</a>
				</div>
			</div>
			<div class="hero-image-overlay">
				<video
					class="hero-bg-image"
					id="hero-parallax-img"
					autoplay
					muted
					loop
					playsinline
					poster="/hero-tips-poster.webp"
				>
					<source src="/hero-tips.mp4" type="video/mp4" />
				</video>
			</div>
			<div class="hero-decoration">
				<div class="decoration-circle circle-1"></div>
				<div class="decoration-circle circle-2"></div>
				<div class="decoration-circle circle-3"></div>
			</div>
		</section>

		<!-- Features Section -->
		<section class="features">
			<div class="container">
				<h2 class="section-title">¿Por qué RideMotoHub?</h2>
				<p class="section-subtitle">
					Más que un grupo, somos una comunidad unida por la pasión de
					rodar
				</p>

				<div class="features-grid">
					<div class="feature-card">
						<div class="feature-icon">🤝</div>
						<h3>Todas las Cilindradas</h3>
						<p>
							No importa si tienes una 125cc o una 1000cc, aquí
							todos somos bienvenidos. La pasión por las motos nos
							une.
						</p>
					</div>

					<a href="/rutas" class="feature-card feature-card-link">
						<div class="feature-icon">🗺️</div>
						<h3>Rutas Épicas</h3>
						<p>
							Descubre las mejores rutas de Guatemala, desde la
							costa hasta las montañas. Rodadas organizadas cada
							semana.
						</p>
						<span class="feature-link-hint">Ver rutas →</span>
					</a>

					<a href="/eventos" class="feature-card feature-card-link">
						<div class="feature-icon">📅</div>
						<h3>Eventos & Rodadas</h3>
						<p>
							Participa en eventos exclusivos, rodadas grupales y
							encuentros de la comunidad motera guatemalteca.
						</p>
						<span class="feature-link-hint">Ver eventos →</span>
					</a>

					<a href="/tips" class="feature-card feature-card-link">
						<div class="feature-icon">💡</div>
						<h3>Tips & Consejos</h3>
						<p>
							Aprende sobre mantenimiento, seguridad vial, y
							mejores prácticas de riders experimentados.
						</p>
						<span class="feature-link-hint">Ver tips →</span>
					</a>

					<div class="feature-card">
						<div class="feature-icon">📸</div>
						<h3>Comparte Experiencias</h3>
						<p>
							Comparte tus aventuras, fotos y experiencias con una
							comunidad que entiende tu pasión.
						</p>
					</div>

					<div class="feature-card">
						<div class="feature-icon">🔧</div>
						<h3>Red de Apoyo</h3>
						<p>
							Encuentra talleres confiables, recomendaciones de
							repuestos y ayuda cuando más lo necesites.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Community Stats -->
		<section class="stats">
			<div class="container">
				<div class="stats-grid">
					<div class="stat-item">
						<div class="stat-number">500+</div>
						<div class="stat-label">Riders Activos</div>
					</div>
					<div class="stat-item">
						<div class="stat-number">50+</div>
						<div class="stat-label">Rodadas Organizadas</div>
					</div>
					<div class="stat-item">
						<div class="stat-number">100%</div>
						<div class="stat-label">Pasión por las Motos</div>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="cta-section">
			<div class="container">
				<div class="cta-content">
					<h2>¿Listo para unirte a la comunidad?</h2>
					<p>
						Forma parte de la familia RideMotoHub y descubre todo lo
						que Guatemala tiene para ofrecer sobre dos ruedas.
					</p>
					<div class="cta-buttons">
						<a href="/blog" class="btn btn-primary btn-large">
							Explorar Blog
						</a>
						<a href="/about" class="btn btn-outline btn-large">
							Más Información
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Recent Posts Section -->
		<section class="recent-posts">
			<div class="container">
				<h2 class="section-title">Últimos del Blog</h2>
				<p class="section-subtitle">
					Rutas, tips y cultura motera desde Guatemala
				</p>
				<div class="posts-preview-grid">
					{recentPosts.map((post) => (
						<a href={`/blog/${post.id}/`} class="post-preview-card">
							{post.data.heroImage && (
								<div class="post-preview-img">
									<Image
										width={600}
										height={338}
										src={post.data.heroImage}
										alt={post.data.imageAlt || `${post.data.title} - RideMotoHub`}
										loading="lazy"
										decoding="async"
									/>
								</div>
							)}
							<div class="post-preview-body">
								{post.data.category && (
									<span class="post-preview-cat">{post.data.category}</span>
								)}
								<h3 class="post-preview-title">{post.data.title}</h3>
								<p class="post-preview-desc">{post.data.description}</p>
								<span class="post-preview-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</div>
						</a>
					))}
				</div>
				<div class="posts-preview-cta">
					<a href="/blog" class="btn btn-secondary">Ver todos los artículos →</a>
				</div>
			</div>
		</section>

		<Footer />
	</body>
</html>

<style>
		@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700&display=swap');
		
	/* ── Obsidian Velocity Design Tokens ── */
	:root {
		--ov-primary:        #69daff;
		--ov-primary-dim:    #00c0ea;
		--ov-secondary:      #ac89ff;
		--ov-tertiary:       #ff5dd7;
		--ov-bg:             #0d0d19;
		--ov-surface-low:    #121220;
		--ov-surface-mid:    #181827;
		--ov-surface-high:   #1e1e2f;
		--ov-surface-top:    #242436;
		--ov-surface-bright: #2a2a3e;
		--ov-on-surface:     #e9e6f9;
		--ov-on-surface-var: #aba9ba;
		--ov-outline:        #757484;
		--ov-outline-var:    #474655;
		--ov-tint:           #69daff;
	}


	body {
		overflow-x: hidden;
		background: var(--ov-bg);
		color: var(--ov-on-surface);
		font-family: 'Manrope', sans-serif;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	/* ── Hero ── */
	.hero {
		position: relative;
		min-height: 90vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 4rem 2rem;
		overflow: hidden;
		background: var(--ov-bg);
	}

	.hero-content {
		position: relative;
		z-index: 3;
		text-align: center;
		max-width: 800px;
		color: var(--ov-on-surface);
		animation: fadeInUp 1s ease-out;
	}

	.hero-badge {
		display: inline-block;
		padding: 0.45rem 1.25rem;
		/* Glass pill: surface_variant 60% + primary ghost border */
		background: rgba(36, 36, 54, 0.6);
		border: 1px solid rgba(105, 218, 255, 0.25);
		backdrop-filter: blur(12px);
		color: var(--ov-primary);
		border-radius: 9999px;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		margin-bottom: 2rem;
		box-shadow: 0 0 16px rgba(105, 218, 255, 0.12);
		animation: pulse 3s ease-in-out infinite;
	}

	.hero-title {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(3rem, 8vw, 5.5rem);
		font-weight: 900;
		letter-spacing: -0.04em;
		margin: 0 0 1.5rem 0;
		line-height: 1.05;
	}

	.gradient-text {
		/* CTA gradient: primary → secondary at 135° */
		background: linear-gradient(135deg, var(--ov-primary) 0%, var(--ov-secondary) 60%, var(--ov-tertiary) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(1.2rem, 3vw, 1.7rem);
		color: var(--ov-on-surface);
		margin: 0 0 1rem 0;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.hero-description {
		font-size: clamp(1rem, 2vw, 1.15rem);
		color: var(--ov-on-surface-var);
		margin: 0 auto 3rem;
		line-height: 1.7;
		max-width: 580px;
	}

	.hero-cta {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	/* ── Buttons ── */
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.85rem 1.75rem;
		border-radius: 9999px;
		font-family: 'Space Grotesk', sans-serif;
		font-weight: 700;
		font-size: 0.95rem;
		letter-spacing: 0.01em;
		text-decoration: none;
		transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
		cursor: pointer;
		border: none;
	}

	/* Primary: gradient primary → secondary */
	.btn-primary {
		background: linear-gradient(135deg, var(--ov-primary), var(--ov-secondary));
		color: #004a5d;
		box-shadow: 0 4px 20px rgba(105, 218, 255, 0.25);
	}
	.btn-primary:hover {
		transform: scale(1.04);
		box-shadow: 0 0 0 3px rgba(0, 192, 234, 0.2), 0 8px 28px rgba(105, 218, 255, 0.35);
	}

	/* Secondary: ghost style — surface_variant 20% + primary border */
	.btn-secondary {
		background: rgba(36, 36, 54, 0.5);
		color: var(--ov-primary);
		border: 1px solid rgba(105, 218, 255, 0.35);
		backdrop-filter: blur(8px);
	}
	.btn-secondary:hover {
		background: rgba(105, 218, 255, 0.08);
		border-color: var(--ov-primary);
		transform: scale(1.04);
	}

	/* Outline (used in CTA section) */
	.btn-outline {
		background: transparent;
		color: var(--ov-on-surface-var);
		border: 1px solid rgba(71, 70, 85, 0.6);
	}
	.btn-outline:hover {
		color: var(--ov-on-surface);
		border-color: rgba(105, 218, 255, 0.4);
		background: rgba(105, 218, 255, 0.05);
		transform: scale(1.04);
	}

	.btn-large {
		padding: 1rem 2.25rem;
		font-size: 1rem;
	}

	/* ── Hero image parallax ── */
	.hero-image-overlay {
		position: absolute;
		top: -30%;
		left: 0;
		width: 100%;
		height: 160%;
		z-index: 1;
		pointer-events: none;
		will-change: transform;
	}

	.hero-bg-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center center;
		filter: brightness(0.38) saturate(1.2);
		display: block;
	}

	/* ── Hero decoration circles ── */
	.hero-decoration {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 2;
	}

	.decoration-circle {
		position: absolute;
		border-radius: 50%;
		animation: float 8s ease-in-out infinite;
	}

	.circle-1 {
		width: 500px; height: 500px;
		top: -120px; right: -120px;
		background: radial-gradient(circle, rgba(105, 218, 255, 0.06) 0%, transparent 70%);
		animation-delay: 0s;
	}
	.circle-2 {
		width: 360px; height: 360px;
		bottom: -60px; left: -60px;
		background: radial-gradient(circle, rgba(172, 137, 255, 0.07) 0%, transparent 70%);
		animation-delay: 2.5s;
	}
	.circle-3 {
		width: 240px; height: 240px;
		top: 40%; left: 8%;
		background: radial-gradient(circle, rgba(255, 93, 215, 0.05) 0%, transparent 70%);
		animation-delay: 5s;
	}

	/* ── Features ── surface_container_low */
	.features {
		padding: 6rem 0;
		background: var(--ov-surface-low);
	}

	.section-title {
		font-family: 'Space Grotesk', sans-serif;
		text-align: center;
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		margin: 0 0 1rem 0;
		color: var(--ov-on-surface);
	}

	.section-subtitle {
		font-family: 'Manrope', sans-serif;
		text-align: center;
		font-size: clamp(1rem, 2vw, 1.2rem);
		color: var(--ov-on-surface-var);
		margin: 0 auto 4rem;
		max-width: 560px;
		line-height: 1.7;
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1.5rem;
		margin-top: 3rem;
	}

	/* Cards: surface_container with lg (1rem) radius, NO borders */
	.feature-card {
		padding: 2.25rem;
		background: var(--ov-surface-mid);
		border-radius: 16px;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		cursor: pointer;
	}
	.feature-card:hover {
		transform: translateY(-6px);
		background: var(--ov-surface-high);
		/* Ambient shadow tinted with surface_tint */
		box-shadow: 0 20px 40px rgba(105, 218, 255, 0.08);
	}

	.feature-icon {
		font-size: 2.5rem;
		margin-bottom: 1.25rem;
		display: inline-block;
	}

	.feature-card h3 {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 1.3rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin: 0 0 0.75rem 0;
		color: var(--ov-on-surface);
	}

	.feature-card p {
		font-family: 'Manrope', sans-serif;
		color: var(--ov-on-surface-var);
		line-height: 1.7;
		margin: 0;
		font-size: 0.95rem;
	}

	/* ── Stats — surface_container_highest ── */
	.stats {
		padding: 5rem 0;
		background: var(--ov-surface-top);
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 3rem;
		text-align: center;
	}

	.stat-item { animation: fadeInUp 1s ease-out; }

	.stat-number {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 900;
		letter-spacing: -0.04em;
		margin-bottom: 0.5rem;
		/* Use primary for key data points */
		background: linear-gradient(135deg, var(--ov-primary), var(--ov-secondary));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.stat-label {
		font-family: 'Manrope', sans-serif;
		font-size: 0.9rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ov-on-surface-var);
		font-weight: 600;
	}

	/* ── CTA Section — surface_low ── */
	.cta-section {
		padding: 6rem 0;
		background: var(--ov-surface-low);
	}

	.cta-content {
		text-align: center;
		max-width: 680px;
		margin: 0 auto;
	}

	.cta-content h2 {
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		margin: 0 0 1.25rem 0;
		color: var(--ov-on-surface);
	}

	.cta-content p {
		font-family: 'Manrope', sans-serif;
		font-size: clamp(1rem, 2vw, 1.2rem);
		color: var(--ov-on-surface-var);
		margin: 0 0 2.5rem 0;
		line-height: 1.7;
	}

	.cta-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	/* ── Animations ── */
	@keyframes fadeInUp {
		from { opacity: 0; transform: translateY(28px); }
		to   { opacity: 1; transform: translateY(0); }
	}

	@keyframes float {
		0%, 100% { transform: translateY(0) scale(1); }
		50%       { transform: translateY(-24px) scale(1.04); }
	}

	@keyframes pulse {
		0%, 100% { box-shadow: 0 0 16px rgba(105, 218, 255, 0.12); }
		50%       { box-shadow: 0 0 24px rgba(105, 218, 255, 0.22); }
	}

	/* ── Hero quick links ── */
	.hero-quick-links {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 1.5rem;
		flex-wrap: wrap;
	}

	.quick-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.4rem 1.1rem;
		background: rgba(36, 36, 54, 0.5);
		border: 1px solid rgba(71, 70, 85, 0.5);
		border-radius: 9999px;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--ov-on-surface-var);
		text-decoration: none;
		transition: all 0.2s ease;
	}
	.quick-link:hover {
		border-color: rgba(105, 218, 255, 0.4);
		color: var(--ov-primary);
		background: rgba(105, 218, 255, 0.06);
	}

	/* ── Feature cards linkable ── */
	.feature-card-link {
		text-decoration: none;
		display: flex;
		flex-direction: column;
	}
	.feature-card-link:hover {
		transform: translateY(-6px);
		background: var(--ov-surface-high);
		box-shadow: 0 20px 40px rgba(105, 218, 255, 0.08);
	}
	.feature-link-hint {
		display: block;
		margin-top: auto;
		padding-top: 1rem;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--ov-primary);
		opacity: 0;
		transition: opacity 0.2s ease;
	}
	.feature-card-link:hover .feature-link-hint { opacity: 1; }

	/* ── Hero title tagline ── */
	.hero-title-tagline {
		display: block;
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(1.1rem, 2.5vw, 1.55rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ov-on-surface);
		opacity: 0.88;
		margin-top: 0.55rem;
	}

	/* ── Recent Posts ── */
	.recent-posts {
		padding: 6rem 0;
		background: var(--ov-bg);
	}

	.posts-preview-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1.5rem;
		margin-top: 3rem;
	}

	.post-preview-card {
		display: block;
		text-decoration: none;
		background: var(--ov-surface-mid);
		border-radius: 16px;
		overflow: hidden;
		transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease, background 0.3s ease;
	}
	.post-preview-card:hover {
		transform: translateY(-6px);
		background: var(--ov-surface-high);
		box-shadow: 0 20px 40px rgba(105, 218, 255, 0.08);
	}

	.post-preview-img {
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}
	.post-preview-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
