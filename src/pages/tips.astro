---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead
            title="Tips & Consejos - RideMotoHub Guatemala"
            description="Aprende sobre mantenimiento, seguridad vial, técnicas de conducción y más. Consejos de expertos para riders en Guatemala."
        />
    </head>
    <body>
        <Header />

        <!-- Hero Section con Video + Parallax -->
        <section class="page-hero" id="hero">
            <img
                src="/hero-riders.jpg"
                alt="Riders de Guatemala en moto"
                class="hero-video"
            />
            <div class="hero-overlay"></div>
            <div class="hero-content" id="hero-content">
                <div class="hero-badge">💡 Tips & Consejos</div>
                <h1>Guía del Rider</h1>
                <p>
                    Todo lo que necesitas saber para rodar seguro y mantener tu
                    moto en perfecto estado
                </p>
                <a href="#tips" class="hero-cta">Explorar consejos</a>
            </div>
            <div class="hero-scroll-indicator">
                <span></span>
            </div>
        </section>

        <!-- Tips Categories -->
        <section class="tips-section" id="tips">
            <div class="container">
                <!-- Category: Mantenimiento -->
                <div class="category-section">
                    <div class="category-header">
                        <h2>🔧 Mantenimiento</h2>
                        <p>Mantén tu moto en óptimas condiciones</p>
                    </div>

                    <div class="tips-grid">
                        <article class="tip-card">
                            <div class="tip-icon">🛢️</div>
                            <h3>Cambio de Aceite</h3>
                            <p class="tip-intro">
                                El cambio de aceite es fundamental para la vida
                                útil del motor.
                            </p>
                            <div class="tip-content">
                                <h4>Frecuencia recomendada:</h4>
                                <ul>
                                    <li>Motos de calle: cada 3,000-5,000 km</li>
                                    <li>
                                        Motos deportivas: cada 2,000-3,000 km
                                    </li>
                                    <li>Motos de trail: cada 4,000-6,000 km</li>
                                </ul>
                                <div class="tip-highlight">
                                    <strong>💡 Pro Tip:</strong> Cambia el aceite
                                    cuando el motor esté tibio, fluye mejor y arrastra
                                    más impurezas.
                                </div>
                            </div>
                        </article>

                        <article class="tip-card">
                            <div class="tip-icon">⛓️</div>
                            <h3>Mantenimiento de Cadena</h3>
                            <p class="tip-intro">
                                Una cadena bien mantenida mejora el rendimiento
                                y la seguridad.
                            </p>
                            <div class="tip-content">
                                <h4>Pasos básicos:</h4>
                                <ul>
                                    <li>Limpia la cadena cada 500-800 km</li>
                                    <li>Lubrica después de cada limpieza</li>
                                    <li>Ajusta la tensión según manual</li>
                                    <li>Revisa desgaste de piñones</li>
                                </ul>
                                <div class="tip-highlight">
                                    <strong>⚠️ Importante:</strong> Nunca uses WD-40
                                    como lubricante permanente.
                                </div>
                            </div>
                        </article>

                        <article class="tip-card">
                            <div class="tip-icon">🛞</div>
                            <h3>Cuidado de Neumáticos</h3>
                            <p class="tip-intro">
                                Los neumáticos son tu único contacto con el
                                asfalto.
                            </p>
                            <div class="tip-content">
                                <h4>Checklist semanal:</h4>
                                <ul>
                                    <li>Verifica presión de aire (en frío)</li>
                                    <li>Inspecciona desgaste irregular</li>
                                    <li>Busca cortes o grietas</li>
                                    <li>Revisa profundidad de banda</li>
                                </ul>
                                <div class="tip-highlight">
                                    <strong>📊 Presión ideal:</strong> Consulta el
                                    manual de tu moto, varía según modelo y carga.
                                </div>
                            </div>
                        </article>

                        <article class="tip-card">
                            <div class="tip-icon">🔋</div>
                            <h3>Batería</h3>
                            <p class="tip-intro">
                                Evita quedarte sin arranque con estos consejos.
                            </p>
                            <div class="tip-content">
                                <h4>Mantenimiento básico:</h4>
                                <ul>
                                    <li>Limpia terminales regularmente</li>
                                    <li>Verifica nivel de agua (si aplica)</li>
                                    <li>
                                        Carga si no usas la moto por semanas
                                    </li>
                                    <li>Reemplaza cada 2-3 años</li>
                                </ul>
                                <div class="tip-highlight">
                                    <strong>🔌 Tip:</strong> Desconecta el terminal
                                    negativo si guardarás la moto por mucho tiempo.
                                </div>
                            </div>
                        </article>
                    </div>
                </div>

                <!-- Category: Seguridad -->
                <div class="category-section">
                    <div class="category-header">
                        <h2>🛡️ Seguridad Vial</h2>
                        <p>Tu seguridad es lo primero</p>
                    </div>

                    <div class="tips-grid">
                        <article class="tip-card safety">
                            <div class="tip-icon">🪖</div>
                            <h3>Equipo de Protección</h3>
                            <p class="tip-intro">
                                El equipo adecuado puede salvar tu vida.
                            </p>
                            <div class="tip-content">
                                <h4>Equipo esencial:</h4>
                                <ul>
                                    <li>
                                        <strong>Casco:</strong> Certificado DOT/ECE,
                                        reemplazar cada 5 años
                                    </li>
                                    <li>
                                        <strong>Chaqueta:</strong> Con protecciones
                                        en hombros, codos y espalda
                                    </li>
                                    <li>
                                        <strong>Guantes:</strong> Protección de nudillos
                                        y palmas reforzadas
                                    </li>
                                    <li>
                                        <strong>Botas:</strong> Tobilleras, suela
                                        antideslizante
                                    </li>
                                    <li>
                                        <strong>Pantalones:</strong> Con protecciones
                                        en rodillas y caderas
                                    </li>
                                </ul>
                                <div class="tip-highlight">
                                    <strong>⚠️ Nunca:</strong> Comprometas la seguridad
                                    por estética o comodidad.
                                </div>
                            </div>
                        </article>

                        <article class="tip-card safety">
                            <div class="tip-icon">👁️</div>
                            <h3>Conducción Defensiva</h3>
                            <p class="tip-intro">
                                Anticipa peligros y mantente visible.
                            </p>
                            <div class="tip-content">
                                <h4>Reglas de oro:</h4>
                                <ul>
                                    <li>Asume que los demás no te ven</li>
                                    <li>Mantén distancia de seguridad</li>
                                    <li>Escanea constantemente el entorno</li>
                                    <li>Usa luces incluso de día</li>
                                    <li>
                                        Evita puntos ciegos de otros vehículos
                                    </li>
                                </ul>
                                <div class="tip-highlight">
                                    <strong>🚦 Regla 2-3 segundos:</strong> Mantén
                                    esta distancia con el vehículo de adelante.
                                </div>
                            </div>
                        </article>

                        <article class="tip-card safety">
                            <div class="tip-icon">🌧️</div>
                            <h3>Conducción en Lluvia</h3>
                            <p class="tip-intro">
                                El clima de Guatemala puede ser impredecible.
                            </p>
                            <div class="tip-content">
                                <h4>Consejos para lluvia:</h4>
                                <ul>
                                    <li>Reduce velocidad un 30-40%</li>
                                    <li>
                                        Evita líneas pintadas y tapas de
                                        alcantarilla
                                    </li>
                                    <li>Aumenta distancia de frenado</li>
                                    <li>
                                        Usa movimientos suaves y progresivos
                                    </li>
                                    <li>
                                        Activa luces de emergencia si es
                                        necesario
                                    </li>
                                </ul>
                                <div class="tip-highlight">
                                    <strong>⚡ Peligro:</strong> Los primeros 15 minutos
                                    de lluvia son los más resbalosos.
                                </div>
                            </div>
                        </article>

                        <article class="tip-card safety">
                            <div class="tip-icon">🏔️</div>
                            <h3>Conducción en Montaña</h3>
                            <p class="tip-intro">
                                Guatemala tiene rutas montañosas espectaculares.
                            </p>
                            <div class="tip-content">
                                <h4>Técnicas importantes:</h4>
                                <ul>
                                    <li>Usa el freno motor en bajadas</li>
                                    <li>
                                        Mira hacia donde quieres ir en curvas
                                    </li>
                                    <li>
                                        Mantén marcha baja en subidas empinadas
                                    </li>
                                    <li>Cuidado con grava en curvas</li>
                                    <li>Descansa cada hora</li>
                                </ul>
                                <div class="tip-highlight">
                                    <strong>🎯 Técnica:</strong> "Lento a la entrada,
                                    rápido a la salida" en curvas cerradas.
                                </div>
                            </div>
                        </article>
                    </div>
                </div>

                <!-- Category: Técnicas -->
                <div class="category-section">
                    <div class="category-header">
                        <h2>🏍️ Técnicas de Conducción</h2>
                        <p>Mejora tus habilidades sobre dos ruedas</p>
                    </div>

                    <div class="tips-grid">
                        <article class="tip-card technique">
                            <div class="tip-icon">🎯</div>
                            <h3>Frenado de Emergencia</h3>
                            <p class="tip-intro">
                                Saber frenar correctamente puede evitar
                                accidentes.
                            </p>
                            <div class="tip-content">
                                <h4>Técnica correcta:</h4>
                                <ul>
                                    <li>Usa ambos frenos simultáneamente</li>
                                    <li>70% freno delantero, 30% trasero</li>
                                    <li>Presión progresiva, no brusca</li>
                                    <li>Mantén la moto vertical</li>
                                    <li>Mira hacia donde quieres ir</li>
                                </ul>
                                <div class="tip-highlight">
                                    <strong>🏋️ Práctica:</strong> Practica en lugar
                                    seguro hasta que sea un reflejo.
                                </div>
                            </div>
                        </article>

                        <article class="tip-card technique">
                            <div class="tip-icon">🔄</div>
                            <h3>Contramanillar</h3>
                            <p class="tip-intro">
                                La técnica esencial para curvas a velocidad.
                            </p>
                            <div class="tip-content">
                                <h4>Cómo funciona:</h4>
                                <ul>
                                    <li>
                                        Para girar a la derecha, empuja manillar
                                        derecho
                                    </li>
                                    <li>
                                        Para girar a la izquierda, empuja
                                        manillar izquierdo
                                    </li>
                                    <li>
                                        La moto se inclina en dirección opuesta
                                        al empuje
                                    </li>
                                    <li>
                                        Funciona mejor a velocidades
                                        medias-altas
                                    </li>
                                </ul>
                                <div class="tip-highlight">
                                    <strong>🧪 Prueba:</strong> En recta segura, empuja
                                    suavemente un manillar y siente la respuesta.
                                </div>
                            </div>
                        </article>

                        <article class="tip-card technique">
                            <div class="tip-icon">⚖️</div>
                            <h3>Balance y Postura</h3>
                            <p class="tip-intro">
                                La postura correcta mejora control y reduce
                                fatiga.
                            </p>
                            <div class="tip-content">
                                <h4>Postura ideal:</h4>
                                <ul>
                                    <li>
                                        Brazos relajados, codos ligeramente
                                        flexionados
                                    </li>
                                    <li>Agarre firme pero no tenso</li>
                                    <li>Rodillas apretando el tanque</li>
                                    <li>Espalda recta, mirada al horizonte</li>
                                    <li>
                                        Pies en estribos, listos para frenar
                                    </li>
                                </ul>
                                <div class="tip-highlight">
                                    <strong>💪 Recuerda:</strong> Tu cuerpo controla
                                    la moto, no solo tus manos.
                                </div>
                            </div>
                        </article>

                        <article class="tip-card technique">
                            <div class="tip-icon">🚦</div>
                            <h3>Arranques Suaves</h3>
                            <p class="tip-intro">
                                Domina el embrague para arranques perfectos.
                            </p>
                            <div class="tip-content">
                                <h4>Pasos para arranque perfecto:</h4>
                                <ul>
                                    <li>
                                        Encuentra el punto de fricción del
                                        embrague
                                    </li>
                                    <li>
                                        Suelta embrague suavemente mientras
                                        aceleras
                                    </li>
                                    <li>Mantén RPMs constantes (2000-3000)</li>
                                    <li>Coordina mano y muñeca</li>
                                </ul>
                                <div class="tip-highlight">
                                    <strong>🎓 Práctica:</strong> Practica en pendiente
                                    para dominar el control.
                                </div>
                            </div>
                        </article>
                    </div>
                </div>

                <!-- Category: Preparación de Viaje -->
                <div class="category-section">
                    <div class="category-header">
                        <h2>🎒 Preparación de Viaje</h2>
                        <p>Lista para tu próxima aventura</p>
                    </div>

                    <div class="checklist-container">
                        <div class="checklist-column">
                            <h3>✅ Antes de Salir</h3>
                            <ul class="checklist">
                                <li>Revisar presión de neumáticos</li>
                                <li>Verificar nivel de aceite</li>
                                <li>Probar luces y señales</li>
                                <li>Revisar frenos</li>
                                <li>Cargar celular completamente</li>
                                <li>Planear ruta y paradas</li>
                                <li>Verificar clima</li>
                                <li>Informar a alguien tu ruta</li>
                            </ul>
                        </div>

                        <div class="checklist-column">
                            <h3>🎒 Qué Llevar</h3>
                            <ul class="checklist">
                                <li>Kit de herramientas básicas</li>
                                <li>Bomba de aire portátil</li>
                                <li>Kit de primeros auxilios</li>
                                <li>Agua y snacks</li>
                                <li>Protector solar</li>
                                <li>Impermeable</li>
                                <li>Documentos (licencia, seguro)</li>
                                <li>Dinero en efectivo</li>
                                <li>Cargador de celular</li>
                                <li>Candado para moto</li>
                            </ul>
                        </div>

                        <div class="checklist-column">
                            <h3>🔧 Kit de Emergencia</h3>
                            <ul class="checklist">
                                <li>Llaves Allen y destornilladores</li>
                                <li>Llave de bujías</li>
                                <li>Cinta americana (duct tape)</li>
                                <li>Alambre</li>
                                <li>Parche para llantas</li>
                                <li>Fusibles de repuesto</li>
                                <li>Aceite de motor (1L)</li>
                                <li>Linterna</li>
                                <li>Guantes de trabajo</li>
                                <li>Número de grúa</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- CTA -->
                <div class="cta-box">
                    <h3>¿Tienes un consejo para compartir?</h3>
                    <p>
                        La comunidad crece con el conocimiento de todos.
                        Comparte tus tips y experiencias.
                    </p>
                    <a href="/blog" class="btn btn-primary">Compartir Consejo</a
                    >
                </div>
            </div>
        </section>

        <Footer />
    </body>
</html>

<style is:global>
    main {
        width: 100% !important;
        max-width: 100% !important;
        padding: 0 !important;
    }
    body {
        margin: 0 !important;
        padding: 0 !important;
        background: #0d0d19 !important;
        background-image: none !important;
        font-size: 16px !important;
        overflow-x: hidden;
    }
    body > section,
    body > div {
        margin-top: 0 !important;
    }
</style>

<style>
    :root {
        --ov-primary:        #69daff;
        --ov-secondary:      #ac89ff;
        --ov-tertiary:       #ff5dd7;
        --ov-bg:             #0d0d19;
        --ov-surface-low:    #121220;
        --ov-surface-mid:    #181827;
        --ov-surface-high:   #1e1e2f;
        --ov-surface-top:    #242436;
        --ov-on-surface:     #e9e6f9;
        --ov-on-surface-var: #aba9ba;
        --ov-outline-var:    #474655;
    }

    body {
        background: var(--ov-bg);
        color: var(--ov-on-surface);
        font-family: 'Manrope', sans-serif;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* ===== VIDEO HERO + PARALLAX ===== */
    .page-hero {
        position: relative;
        min-height: 100vh;
        margin-top: -64px;  /* pull behind sticky header (64px) */
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .hero-video {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        will-change: transform;
        /* transform updated by JS parallax */
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            rgba(13, 13, 25, 0.45) 0%,
            rgba(13, 13, 25, 0.72) 55%,
            rgba(13, 13, 25, 0.97) 100%
        );
        z-index: 1;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        max-width: 760px;
        padding: 0 1.5rem;
        will-change: transform;
        /* transform updated by JS for text counter-parallax */
    }

    .hero-badge {
        display: inline-block;
        padding: 0.35rem 1rem;
        background: rgba(105, 218, 255, 0.08);
        border: 1px solid rgba(105, 218, 255, 0.3);
        border-radius: 9999px;
        font-family: 'Manrope', sans-serif;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--ov-primary);
        margin-bottom: 1.5rem;
    }

    .hero-content h1 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(3rem, 7vw, 5.5rem);
        font-weight: 900;
        letter-spacing: -0.04em;
        line-height: 1.0;
        margin: 0 0 1.25rem;
        color: var(--ov-on-surface);
        background: linear-gradient(135deg, #ffffff, #e9e6f9, #69daff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero-content p {
        font-size: clamp(1rem, 2vw, 1.2rem);
        color: var(--ov-on-surface-var);
        line-height: 1.7;
        margin: 0 0 2rem;
    }

    .hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.85rem 2rem;
        background: linear-gradient(135deg, var(--ov-primary), var(--ov-secondary));
        color: #003d4d;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 0.95rem;
        border-radius: 9999px;
        text-decoration: none;
        box-shadow: 0 4px 20px rgba(105, 218, 255, 0.25);
        transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
    }

    .hero-cta::after {
        content: '↓';
        font-size: 1rem;
    }

    .hero-cta:hover {
        opacity: 0.9;
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(105, 218, 255, 0.35);
    }

    /* Scroll indicator */
    .hero-scroll-indicator {
        position: absolute;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2;
    }

    .hero-scroll-indicator span {
        display: block;
        width: 24px;
        height: 40px;
        border: 2px solid rgba(105, 218, 255, 0.4);
        border-radius: 9999px;
        position: relative;
    }

    .hero-scroll-indicator span::before {
        content: '';
        position: absolute;
        top: 6px;
        left: 50%;
        transform: translateX(-50%);
        width: 4px;
        height: 8px;
        background: var(--ov-primary);
        border-radius: 9999px;
        animation: scroll-dot 1.8s ease-in-out infinite;
    }

    @keyframes scroll-dot {
        0%   { opacity: 1; transform: translateX(-50%) translateY(0); }
        80%  { opacity: 0; transform: translateX(-50%) translateY(16px); }
        100% { opacity: 0; transform: translateX(-50%) translateY(16px); }
    }

    /* ===== TIPS SECTION ===== */
    .tips-section {
        padding: 5rem 0;
        background: var(--ov-bg);
    }

    .category-section {
        margin-bottom: 5rem;
    }

    .category-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .category-header h2 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        font-weight: 900;
        letter-spacing: -0.03em;
        margin: 0 0 0.5rem;
        color: var(--ov-on-surface);
    }

    .category-header p {
        font-size: 1rem;
        color: var(--ov-on-surface-var);
        margin: 0;
    }

    .tips-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .tip-card {
        background: var(--ov-surface-mid);
        border-radius: 16px;
        padding: 1.75rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
    }

    .tip-card:hover {
        transform: translateY(-4px);
        background: var(--ov-surface-high);
        box-shadow: 0 16px 32px rgba(105, 218, 255, 0.08);
    }

    .tip-card.safety:hover {
        box-shadow: 0 16px 32px rgba(255, 93, 215, 0.08);
    }

    .tip-card.technique:hover {
        box-shadow: 0 16px 32px rgba(172, 137, 255, 0.1);
    }

    .tip-icon {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        display: block;
    }

    .tip-card h3 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin: 0 0 0.75rem;
        color: var(--ov-on-surface);
    }

    .tip-intro {
        color: var(--ov-on-surface-var);
        font-size: 0.9rem;
        margin-bottom: 1.25rem;
        font-style: italic;
        line-height: 1.6;
    }

    .tip-content h4 {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--ov-primary);
        margin: 0 0 0.75rem;
    }

    .tip-content ul {
        list-style: none;
        padding: 0;
        margin: 0 0 1.25rem;
    }

    .tip-content li {
        padding: 0.4rem 0 0.4rem 1.25rem;
        color: var(--ov-on-surface-var);
