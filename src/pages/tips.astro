<script>
    // Parallax — video se mueve más lento que el scroll, texto en dirección contraria
    const hero = document.getElementById('hero');
    const video = hero?.querySelector('.hero-video') as HTMLElement | null;
    const content = document.getElementById('hero-content') as HTMLElement | null;

    function onScroll() {
        if (!hero || !video || !content) return;
        const scrollY = window.scrollY;
        const heroH = hero.offsetHeight;
        if (scrollY > heroH) return;

        // Video: se desplaza a 40% de la velocidad de scroll (efecto parallax)
        video.style.transform = `translateY(${scrollY * 0.4}px)`;
        // Texto: sube ligeramente más rápido (profundidad)
        content.style.transform = `translateY(${scrollY * 0.15}px)`;
    }

    window.addEventListener('scroll', onScroll, { passive: true });
</script>
